<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ImmichSplash.App.Services"
             xmlns:vm="using:ImmichSplash.App.ViewModels"
             xmlns:c="using:ImmichSplash.App.Controls"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="ImmichSplash.App.Views.PhotoEditorView"
             x:DataType="vm:PhotoEditorViewModel">
  <UserControl.Styles>
    <Style Selector="Button.aspect">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.aspect:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#22FFFFFF" />
    </Style>
    <Style Selector="Border.aspectIcon">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="CornerRadius" Value="22" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="BorderBrush" Value="#99FFFFFF" />
    </Style>
    <Style Selector="Border.aspectIcon.selected">
      <Setter Property="Background" Value="#FFB8C6FF" />
      <Setter Property="BorderBrush" Value="#FFB8C6FF" />
    </Style>
    <Style Selector="Button.orient">
      <Setter Property="Background" Value="#FFB8C6FF" />
      <Setter Property="Foreground" Value="#FF101828" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="0,10" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,320" Background="#FF0B0B0C">
    <!-- The photo, with the crop frame -->
    <Panel Margin="12">
      <c:PhotoEditCanvas Source="{Binding Source}" Rotation="{Binding Rotation}" MirrorHorizontal="{Binding MirrorHorizontal}"
                         MirrorVertical="{Binding MirrorVertical}" Crop="{Binding Crop, Mode=TwoWay}" Aspect="{Binding Aspect}"
                         IsVisible="{Binding ShowEditor}" />
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsVisible="{Binding IsLoading}">
        <mi:MaterialIcon Kind="Loading" Classes="spin" Width="32" Height="32" Foreground="White" />
        <TextBlock l:Tr.Text="Opening the photo…" Foreground="White" />
      </StackPanel>
      <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Padding="16,10" CornerRadius="12" Background="#E6000000"
              IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding Error}" Foreground="#FFFFB4B4" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" />
      </Border>
    </Panel>

    <!-- The tools -->
    <Border Grid.Column="1" Background="#FF121214" BorderBrush="#22FFFFFF" BorderThickness="1,0,0,0" Padding="18">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,18">
          <Button Classes="ghost icon" Command="{Binding CloseCommand}" l:Tr.Tip="Close" AutomationProperties.Name="Close">
            <mi:MaterialIcon Kind="Close" Width="22" Height="22" Foreground="White" />
          </Button>
          <TextBlock Grid.Column="1" l:Tr.Text="Editor" FontSize="18" FontWeight="Medium" Foreground="White" VerticalAlignment="Center" Margin="10,0" />
          <Button Grid.Column="2" Classes="primary" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="Loading" Classes="spin" Width="16" Height="16" IsVisible="{Binding IsSaving}" />
              <TextBlock l:Tr.Text="Save" />
            </StackPanel>
          </Button>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
          <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" l:Tr.Content="Remove all edits" Command="{Binding RemoveEditsCommand}" IsVisible="{Binding HadEdits}" />
          <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" l:Tr.Content="Reset changes" Command="{Binding ResetCommand}" IsEnabled="{Binding HasChanges}" />
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12">
            <TextBlock Classes="secondary" TextWrapping="Wrap" IsVisible="{Binding HadEdits}" Foreground="#B3FFFFFF"
                       l:Tr.Text="This photo already has edits. Saving replaces them; you start again from the original." />
            <TextBlock l:Tr.Text="Orientation" Foreground="#B3FFFFFF" />
            <UniformGrid Columns="4">
              <Button Classes="orient" Margin="0,0,6,0" Command="{Binding RotateLeftCommand}" l:Tr.Tip="Turn left" AutomationProperties.Name="Turn left"><mi:MaterialIcon Kind="RotateLeft" Width="20" Height="20" /></Button>
              <Button Classes="orient" Margin="0,0,6,0" Command="{Binding RotateRightCommand}" l:Tr.Tip="Turn right" AutomationProperties.Name="Turn right"><mi:MaterialIcon Kind="RotateRight" Width="20" Height="20" /></Button>
              <Button Classes="orient" Margin="0,0,6,0" Command="{Binding FlipHorizontalCommand}" l:Tr.Tip="Flip left to right" AutomationProperties.Name="Flip left to right"><mi:MaterialIcon Kind="FlipHorizontal" Width="20" Height="20" /></Button>
              <Button Classes="orient" Command="{Binding FlipVerticalCommand}" l:Tr.Tip="Flip top to bottom" AutomationProperties.Name="Flip top to bottom"><mi:MaterialIcon Kind="FlipVertical" Width="20" Height="20" /></Button>
            </UniformGrid>

            <TextBlock l:Tr.Text="Crop" Foreground="#B3FFFFFF" Margin="0,12,0,0" />
            <ItemsControl ItemsSource="{Binding Aspects}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AspectChoiceViewModel">
                  <Button Classes="aspect" Command="{Binding $parent[ItemsControl].((vm:PhotoEditorViewModel)DataContext).SelectAspectCommand}" CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding Label}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Border Classes="aspectIcon" Classes.selected="{Binding IsSelected}">
                        <mi:MaterialIcon Kind="{Binding Icon}" Width="22" Height="22" Foreground="White" />
                      </Border>
                      <TextBlock Text="{Binding Label}" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
