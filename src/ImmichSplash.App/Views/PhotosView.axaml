<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ImmichSplash.App.Services"
             xmlns:vm="using:ImmichSplash.App.ViewModels"
             xmlns:c="using:ImmichSplash.App.Controls"
             xmlns:p="using:ImmichSplash.App.Views.Photos"
             xmlns:api="using:ImmichSplash.Core.Api"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="ImmichSplash.App.Views.PhotosView"
             x:DataType="vm:PhotosViewModel">
  <UserControl.DataTemplates>
    <!-- Memories: the first row of the timeline -->
    <DataTemplate DataType="vm:MemoriesRowViewModel">
      <ScrollViewer Height="236" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="2,14,0,18">
        <ItemsControl ItemsSource="{Binding Cards}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MemoryCardViewModel">
              <Button Classes="cover" Width="152" Command="{Binding OpenCommand}">
                <Border Classes="coverImage" Width="152" Height="200" CornerRadius="16" ClipToBounds="True" Background="{DynamicResource AppNeutralSoftBrush}">
                  <Panel>
                    <mi:MaterialIcon Kind="ImageMultipleOutline" Width="36" Height="36" Foreground="{DynamicResource AppTextTertiaryBrush}" />
                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                    <Border VerticalAlignment="Bottom" Padding="12,32,12,10">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                          <GradientStop Color="#00000000" Offset="0" />
                          <GradientStop Color="#B3000000" Offset="1" />
                        </LinearGradientBrush>
                      </Border.Background>
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" Foreground="#E6FFFFFF" FontSize="12" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Border>
                  </Panel>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DataTemplate>
    <DataTemplate DataType="vm:MonthHeaderViewModel">
      <StackPanel Orientation="Horizontal" Spacing="10" Height="54" VerticalAlignment="Bottom" Margin="2,0,0,0">
        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Medium" VerticalAlignment="Bottom" Margin="0,0,0,12" />
        <TextBlock Classes="caption tertiary" Text="{Binding Count}" VerticalAlignment="Bottom" Margin="0,0,0,14" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:AssetRowViewModel">
      <ItemsControl ItemsSource="{Binding Cells}" Height="{Binding RowHeight}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AssetCellViewModel">
            <Button Classes="tile" Classes.selected="{Binding IsSelected}" Width="{Binding TileWidth}" Height="{Binding TileHeight}" VerticalAlignment="Top"
                    AutomationProperties.Name="{Binding AccessibleName}"
                    Command="{Binding OpenCommand}" IsVisible="{Binding !IsMissing}" IsEnabled="{Binding CanOpen}">
              <Button.ContextMenu>
                <ContextMenu Opening="OnTileMenuOpening">
                  <MenuItem l:Tr.Header="Open" Command="{Binding OpenCommand}"><MenuItem.Icon><mi:MaterialIcon Kind="ImageOutline" /></MenuItem.Icon></MenuItem>
                  <MenuItem l:Tr.Header="Select" Command="{Binding ToggleSelectCommand}"><MenuItem.Icon><mi:MaterialIcon Kind="CheckCircleOutline" /></MenuItem.Icon></MenuItem>
                  <Separator />
                  <MenuItem Header="{Binding FavoriteText}" Command="{Binding ToggleFavoriteCommand}"><MenuItem.Icon><mi:MaterialIcon Kind="HeartOutline" /></MenuItem.Icon></MenuItem>
                  <MenuItem l:Tr.Header="Add to album" Command="{Binding AddToAlbumCommand}"><MenuItem.Icon><mi:MaterialIcon Kind="Plus" /></MenuItem.Icon></MenuItem>
                  <MenuItem l:Tr.Header="Share" Command="{Binding ShareCommand}"><MenuItem.Icon><mi:MaterialIcon Kind="ShareVariantOutline" /></MenuItem.Icon></MenuItem>
                  <MenuItem l:Tr.Header="Download" Command="{Binding DownloadCommand}"><MenuItem.Icon><mi:MaterialIcon Kind="TrayArrowDown" /></MenuItem.Icon></MenuItem>
                  <Separator IsVisible="{Binding CanTrash}" />
                  <MenuItem l:Tr.Header="Move to trash" Command="{Binding TrashCommand}" IsVisible="{Binding CanTrash}"><MenuItem.Icon><mi:MaterialIcon Kind="TrashCanOutline" /></MenuItem.Icon></MenuItem>
                </ContextMenu>
              </Button.ContextMenu>
              <Panel>
                <Image Classes="thumb" Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                <!-- A file on this PC we can't preview here (video, HEIC…) -->
                <StackPanel IsVisible="{Binding ShowLocalPlaceholder}" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                  <mi:MaterialIcon Kind="{Binding IsVideo, Converter={x:Static vm:Converters.LocalFileIcon}}" Width="30" Height="30"
                                   Foreground="{DynamicResource AppTextTertiaryBrush}" />
                </StackPanel>
                <!-- Hover shade so the check stays visible on bright photos -->
                <Border Classes="shade" IsHitTestVisible="False" Height="56" VerticalAlignment="Top">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                      <GradientStop Color="#66000000" Offset="0" />
                      <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <!-- Video, live photo and stack badges -->
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" IsHitTestVisible="False">
                  <Border IsVisible="{Binding IsShared}" Padding="5,2" CornerRadius="6" Background="#99000000">
                    <mi:MaterialIcon Kind="LinkVariant" Width="14" Height="14" Foreground="White" />
                  </Border>
                  <Border IsVisible="{Binding IsLivePhoto}" Padding="5,2" CornerRadius="6" Background="#99000000">
                    <mi:MaterialIcon Kind="MotionPlayOutline" Width="14" Height="14" Foreground="White" />
                  </Border>
                  <Border IsVisible="{Binding IsStack}" Padding="6,2" CornerRadius="6" Background="#99000000">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                      <TextBlock Text="{Binding StackText}" Foreground="White" FontSize="11.5" FontWeight="Medium" />
                      <mi:MaterialIcon Kind="LayersOutline" Width="14" Height="14" Foreground="White" />
                    </StackPanel>
                  </Border>
                  <Border IsVisible="{Binding IsVideo}" Padding="6,2" CornerRadius="6" Background="#99000000">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="{Binding DurationText}" Foreground="White" FontSize="11.5" FontWeight="Medium" />
                      <mi:MaterialIcon Kind="PlayCircleOutline" Width="14" Height="14" Foreground="White" />
                    </StackPanel>
                  </Border>
                </StackPanel>
                <mi:MaterialIcon IsVisible="{Binding IsFavorite}" Kind="Heart" Width="16" Height="16" Foreground="White"
                                 HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" />
                <!-- File size (Large files) -->
                <Border IsVisible="{Binding HasSizeText}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5"
                        Padding="6,2" CornerRadius="6" Background="#99000000">
                  <TextBlock Text="{Binding SizeText}" Foreground="White" FontSize="11.5" FontWeight="Medium" />
                </Border>
                <!-- In Immich, on this PC, or both -->
                <Border Classes="syncBadge" Classes.warn="{Binding SyncFailed}" IsVisible="{Binding HasSyncIcon}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5"
                        Padding="3" CornerRadius="8" ToolTip.Tip="{Binding SyncText}">
                  <mi:MaterialIcon Kind="{Binding SyncIcon}" Width="15" Height="15" Foreground="White" />
                </Border>
                <!-- Select -->
                <Button Classes="check" Classes.visible="{Binding IsSelected}" Classes.on="{Binding IsSelected}"
                        Command="{Binding ToggleSelectCommand}" IsVisible="{Binding CanSelect}" l:Tr.Tip="Select">
                  <Panel>
                    <Ellipse Width="22" Height="22" Fill="White" IsVisible="{Binding IsSelected}" />
                    <mi:MaterialIcon Kind="CheckCircle" Width="26" Height="26" IsVisible="{Binding IsSelected}" />
                    <mi:MaterialIcon Kind="CheckboxBlankCircleOutline" Width="24" Height="24" IsVisible="{Binding !IsSelected}" />
                  </Panel>
                </Button>
              </Panel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>
  </UserControl.DataTemplates>

  <UserControl.Styles>
    <!-- The grid is a plain virtualized list: no selection or hover chrome on rows -->
    <Style Selector="ListBox.grid">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.grid ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox.grid ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.grid ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.grid ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.grid ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Tiles -->
    <Style Selector="Button.tile">
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{DynamicResource AppNeutralSoftBrush}" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.playVideo">
      <Setter Property="Background" Value="#88000000" />
      <Setter Property="CornerRadius" Value="40" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.playVideo:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#CC000000" />
    </Style>
    <Style Selector="Button.playVideo:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#88000000" />
    </Style>
    <Style Selector="Button.videoControl">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="7" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.videoControl mi|MaterialIcon">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.videoControl:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Button.toast">
      <Setter Property="Background" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.toast:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="Opacity" Value="0.92" />
    </Style>
    <Style Selector="Slider.videoSeek">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.privacyTile Image.sharp">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.privacyTile.reveal Image.sharp, Button.privacyTile:pointerover Image.sharp">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.privacyTile.reveal :is(Control).blurred, Button.privacyTile:pointerover :is(Control).blurred">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ToggleButton.filterChip">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="12,5" />
    </Style>
    <Style Selector="Button.utility">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.utility:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppNeutralSoftBrush}" />
    </Style>
    <Style Selector="mi|MaterialIcon.utilityIcon">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
    </Style>
    <Style Selector="Button.dupe.trashed Image">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Border.syncBadge">
      <Setter Property="Background" Value="#66000000" />
    </Style>
    <Style Selector="Border.syncBadge.warn">
      <Setter Property="Background" Value="#E0B45309" />
    </Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppNeutralSoftBrush}" />
    </Style>
    <Style Selector="Button.tile:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Button.tile:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppNeutralSoftBrush}" />
    </Style>
    <Style Selector="Button.tile Border.shade">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.tile:pointerover Border.shade">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.tile Image.thumb">
      <Setter Property="Transitions">
        <Transitions><ThicknessTransition Property="Margin" Duration="0:0:0.12" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.tile.selected Image.thumb">
      <Setter Property="Margin" Value="12" />
    </Style>
    <Style Selector="Button.tile.selected">
      <Setter Property="Background" Value="{DynamicResource AppPrimarySoftBrush}" />
    </Style>
    <Style Selector="Button.check">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="6" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Button.tile:pointerover Button.check, Button.check.visible">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.check:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.check.on mi|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
    </Style>

    <!-- Tabs -->
    <Style Selector="RadioButton.tab">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Bg" Background="Transparent" CornerRadius="999" Padding="{TemplateBinding Padding}"
                  BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1">
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="RadioButton.tab:pointerover /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    </Style>
    <Style Selector="RadioButton.tab:checked /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource AppPrimarySoftBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="RadioButton.tab:checked">
      <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
    </Style>

    <!-- Cover cards (albums, people, places) -->
    <Style Selector="Button.cover">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,18,22" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Button.cover:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.cover:pointerover Border.coverImage">
      <Setter Property="Opacity" Value="0.88" />
    </Style>

    <!-- Viewer -->
    <Style Selector="Button.viewerNav">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="22" />
      <Setter Property="Background" Value="#66000000" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.viewerNav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#99000000" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.viewerNav mi|MaterialIcon">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
    </Style>
    <Style Selector="TextBlock.infoLabel">
      <Setter Property="Foreground" Value="#B3FFFFFF" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.infoValue, SelectableTextBlock.infoValue">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.sharedChip">
      <Setter Property="Background" Value="#33FFFFFF" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.sharedChip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#4DFFFFFF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TextBlock.infoHeading">
      <Setter Property="Foreground" Value="#99FFFFFF" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="mi|MaterialIcon.infoIcon">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Margin" Value="0,0,16,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Foreground" Value="#B3FFFFFF" />
    </Style>

    <!-- Selection bar -->
    <Style Selector="Button.barAction">
      <Setter Property="Padding" Value="10,6" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <DockPanel>
      <!-- Header: back, title, search, actions -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="28,20,28,10" IsVisible="{Binding !IsSelecting}">
        <Button Classes="ghost icon" VerticalAlignment="Center" Margin="0,0,8,0" Command="{Binding BackCommand}"
                IsVisible="{Binding IsDrilledIn}" l:Tr.Tip="Back">
          <mi:MaterialIcon Kind="ArrowLeft" Width="22" Height="22" />
        </Button>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="4,0,16,0" IsVisible="{Binding ShowHeading}">
          <TextBlock Classes="h1" Text="{Binding Heading}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="secondary" Text="{Binding Summary}" IsVisible="{Binding ShowGrid}" />
        </StackPanel>
        <TextBox Grid.Column="2" Name="SearchBox" Width="280" VerticalAlignment="Center" Text="{Binding SearchText}"
                 l:Tr.Watermark="Search your photos" IsVisible="{Binding IsPicker}">
          <TextBox.InnerLeftContent>
            <mi:MaterialIcon Kind="Magnify" Width="18" Height="18" Margin="10,0,0,0" Foreground="{DynamicResource AppTextTertiaryBrush}" />
          </TextBox.InnerLeftContent>
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" VerticalAlignment="Center">
          <!-- Thumbnail size (also Ctrl + scroll over the photos) -->
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{Binding ShowGrid}"
                      l:Tr.Tip="Thumbnail size (Ctrl + scroll)">
            <mi:MaterialIcon Kind="ViewGridCompact" Width="16" Height="16" Foreground="{DynamicResource AppTextTertiaryBrush}" />
            <Slider Width="120" Minimum="80" Maximum="360" Value="{Binding ThumbnailSize}" VerticalAlignment="Center" />
            <mi:MaterialIcon Kind="ViewGrid" Width="18" Height="18" Foreground="{DynamicResource AppTextTertiaryBrush}" />
          </StackPanel>
          <Button Classes="primary" Command="{Binding CreateAlbumCommand}" IsVisible="{Binding ShowAlbums}" Margin="0,0,4,0">
            <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Plus" /><TextBlock l:Tr.Text="Create album" /></StackPanel>
          </Button>
          <Button Classes="secondary" Command="{Binding RestoreAllCommand}" IsVisible="{Binding ShowTrashActions}">
            <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Restore" /><TextBlock l:Tr.Text="Restore all" /></StackPanel>
          </Button>
          <Button Classes="secondary danger" Command="{Binding EmptyTrashCommand}" IsVisible="{Binding ShowTrashActions}">
            <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="DeleteForeverOutline" /><TextBlock l:Tr.Text="Empty trash" /></StackPanel>
          </Button>
          <Button Classes="primary" Command="{Binding ArchiveAllCommand}" IsVisible="{Binding ShowArchiveAll}">
            <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="ArchiveArrowDownOutline" /><TextBlock l:Tr.Text="Archive all" /></StackPanel>
          </Button>
          <Button Classes="secondary" Command="{Binding LockCommand}" IsVisible="{Binding ShowLockAction}">
            <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="LockOutline" /><TextBlock l:Tr.Text="Lock" /></StackPanel>
          </Button>
          <Button Classes="ghost icon" Command="{Binding DownloadOpenAlbumCommand}" IsVisible="{Binding CanShareAlbum}" l:Tr.Tip="Download album">
            <mi:MaterialIcon Kind="DownloadOutline" Width="20" Height="20" />
          </Button>
          <Button Classes="ghost icon" Command="{Binding ShareAlbumCommand}" IsVisible="{Binding CanShareAlbum}" l:Tr.Tip="Share album">
            <mi:MaterialIcon Kind="ShareVariantOutline" Width="20" Height="20" />
          </Button>
          <Button Classes="ghost icon" Command="{Binding DeleteOpenAlbumCommand}" IsVisible="{Binding CanDeleteAlbum}" l:Tr.Tip="Delete album">
            <mi:MaterialIcon Kind="TrashCanOutline" Width="20" Height="20" />
          </Button>
          <Button Classes="ghost icon" Command="{Binding RefreshCommand}" l:Tr.Tip="Refresh">
            <mi:MaterialIcon Kind="Refresh" Width="20" Height="20" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- Selection bar: replaces the header while photos are selected -->
      <Border DockPanel.Dock="Top" Margin="20,16,20,10" Padding="8,6" CornerRadius="14" Background="{DynamicResource AppPrimarySoftBrush}"
              IsVisible="{Binding IsSelecting}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="ghost icon" Command="{Binding ClearSelectionCommand}" l:Tr.Tip="Clear selection (Esc)">
              <mi:MaterialIcon Kind="Close" Width="20" Height="20" />
            </Button>
            <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
            <Button Classes="ghost barAction" Command="{Binding SelectAllCommand}" Margin="8,0,0,0" l:Tr.Tip="Select all (Ctrl+A)">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Panel>
                  <mi:MaterialIcon Kind="SelectAll" IsVisible="{Binding !IsSelectingAll}" />
                  <mi:MaterialIcon Kind="Loading" Classes="spin" IsVisible="{Binding IsSelectingAll}" />
                </Panel>
                <TextBlock l:Tr.Text="Select all" />
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
            <Button Classes="ghost barAction" Command="{Binding RestoreSelectionCommand}" IsVisible="{Binding CanRestore}">
              <StackPanel Orientation="Horizontal" Spacing="6"><mi:MaterialIcon Kind="Restore" /><TextBlock l:Tr.Text="Restore" /></StackPanel>
            </Button>
            <Button Classes="ghost barAction" Command="{Binding DeleteSelectionForeverCommand}" IsVisible="{Binding CanRestore}">
              <StackPanel Orientation="Horizontal" Spacing="6"><mi:MaterialIcon Kind="DeleteForeverOutline" /><TextBlock l:Tr.Text="Delete forever" /></StackPanel>
            </Button>
            <Button Classes="ghost barAction" Command="{Binding MoveSelectionOutOfLockedCommand}" IsVisible="{Binding CanMoveOutOfLocked}">
              <StackPanel Orientation="Horizontal" Spacing="6"><mi:MaterialIcon Kind="LockOpenVariantOutline" /><TextBlock l:Tr.Text="Move out of locked folder" /></StackPanel>
            </Button>
            <Button Classes="ghost barAction" Command="{Binding ShareSelectionCommand}" IsVisible="{Binding CanUseNormalActions}" l:Tr.Tip="Share">
              <StackPanel Orientation="Horizontal" Spacing="6"><mi:MaterialIcon Kind="ShareVariantOutline" /><TextBlock l:Tr.Text="Share" /></StackPanel>
            </Button>
            <Button Classes="ghost barAction" Command="{Binding AddSelectionToAlbumCommand}" IsVisible="{Binding CanUseNormalActions}" l:Tr.Tip="Add to album">
              <StackPanel Orientation="Horizontal" Spacing="6"><mi:MaterialIcon Kind="ImagePlusOutline" /><TextBlock l:Tr.Text="Add to album" /></StackPanel>
            </Button>
            <Button Classes="ghost icon" Command="{Binding FavoriteSelectionCommand}" IsVisible="{Binding CanUseNormalActions}" l:Tr.Tip="Favorite">
              <mi:MaterialIcon Kind="HeartOutline" Width="20" Height="20" />
            </Button>
            <Button Classes="ghost icon" Command="{Binding DownloadSelectionCommand}" IsVisible="{Binding !CanRestore}" l:Tr.Tip="Download">
              <mi:MaterialIcon Kind="TrayArrowDown" Width="20" Height="20" />
            </Button>
            <Button Classes="ghost icon" Command="{Binding ArchiveSelectionCommand}" IsVisible="{Binding CanArchive}" l:Tr.Tip="Archive">
              <mi:MaterialIcon Kind="ArchiveArrowDownOutline" Width="20" Height="20" />
            </Button>
            <Button Classes="ghost icon" Command="{Binding UnarchiveSelectionCommand}" IsVisible="{Binding CanUnarchive}" l:Tr.Tip="Unarchive">
              <mi:MaterialIcon Kind="ArchiveArrowUpOutline" Width="20" Height="20" />
            </Button>
            <Button Classes="ghost icon" Command="{Binding MoveSelectionToLockedCommand}" IsVisible="{Binding CanMoveToLocked}" l:Tr.Tip="Move to locked folder">
              <mi:MaterialIcon Kind="LockOutline" Width="20" Height="20" />
            </Button>
            <Button Classes="ghost icon" Command="{Binding TrashSelectionCommand}" IsVisible="{Binding CanUseNormalActions}" l:Tr.Tip="Move to trash">
              <mi:MaterialIcon Kind="TrashCanOutline" Width="20" Height="20" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Panel>
        <!-- Photo grid with the date rail -->
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowGrid}">
          <ListBox Name="Grid" Classes="grid" ItemsSource="{Binding Rows}" Margin="28,0,0,0" Padding="0,0,12,24"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          </ListBox>
          <c:TimelineScrubber Grid.Column="1" Name="Scrubber" Width="56" Sections="{Binding Sections}"
                              IsVisible="{Binding HasSections}" Margin="0,0,4,8" />

          <!-- States -->
          <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoading}">
            <mi:MaterialIcon Kind="Loading" Classes="spin" Width="28" Height="28" Foreground="{DynamicResource AppPrimaryBrush}" />
            <TextBlock Classes="secondary" l:Tr.Text="Loading…" />
          </StackPanel>
          <Border Classes="card" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <StackPanel Spacing="12">
              <mi:MaterialIcon Kind="CloudOffOutline" Width="32" Height="32" Foreground="{DynamicResource AppTextTertiaryBrush}" />
              <TextBlock Text="{Binding Error}" TextWrapping="Wrap" TextAlignment="Center" />
              <Button Classes="primary" HorizontalAlignment="Center" l:Tr.Content="Try again" Command="{Binding RefreshCommand}" />
            </StackPanel>
          </Border>
          <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsEmpty}" MaxWidth="420">
            <mi:MaterialIcon Kind="ImageMultipleOutline" Width="40" Height="40" Foreground="{DynamicResource AppTextTertiaryBrush}" />
            <TextBlock Classes="secondary" Text="{Binding EmptyText}" TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>
        </Grid>

        <!-- Albums -->
        <p:AlbumsSection IsVisible="{Binding ShowAlbums}" />

        <!-- Explore: people and places -->
        <p:ExploreSection IsVisible="{Binding ShowExplore}" />

        <!-- Sharing: shared albums, your links, partners -->
        <p:SharingSection IsVisible="{Binding ShowSharing}" />

        <!-- Utilities, laid out like the Immich web app's -->
        <p:UtilitiesSection IsVisible="{Binding ShowUtilities}" />

        <!-- Suggest for the locked folder (on-device privacy check) -->
        <p:PrivacyReviewSection IsVisible="{Binding ShowPrivacy}" />

        <!-- Review duplicates -->
        <p:DuplicatesSection IsVisible="{Binding ShowDuplicates}" />

        <!-- Locked folder: PIN prompt -->
        <p:LockedPinSection />

        <!-- Map, with the photos of a clicked bubble (or the area in view) beside it -->
        <Grid IsVisible="{Binding ShowMap}" Margin="28,4,28,24" ColumnDefinitions="*,Auto">
          <Panel>
            <Border CornerRadius="18" ClipToBounds="True" BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1">
              <c:MapView Name="Map" Markers="{Binding Markers}" ShowStreetDetail="{Binding ShowStreetDetail}"
                         AllowDark="{Binding MapAllowDark}" HeatMap="{Binding MapHeat}" />
            </Border>
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Spacing="6">
              <Button Classes="secondary icon" Name="ZoomInButton" l:Tr.Tip="Zoom in"><mi:MaterialIcon Kind="Plus" Width="18" Height="18" /></Button>
              <Button Classes="secondary icon" Name="ZoomOutButton" l:Tr.Tip="Zoom out"><mi:MaterialIcon Kind="Minus" Width="18" Height="18" /></Button>
              <Button Classes="secondary icon" Name="FitButton" l:Tr.Tip="Show all photos"><mi:MaterialIcon Kind="FitToScreenOutline" Width="18" Height="18" /></Button>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Spacing="6" Orientation="Horizontal">
              <ToggleButton Padding="12,7" CornerRadius="999" IsChecked="{Binding MapHeat}" l:Tr.Tip="Show where most of your photos are">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <mi:MaterialIcon Kind="Fire" Width="18" Height="18" />
                  <TextBlock l:Tr.Text="Heat map" />
                </StackPanel>
              </ToggleButton>
              <Button Classes="secondary icon" Command="{Binding OpenMapSettingsCommand}" l:Tr.Tip="Map settings">
                <mi:MaterialIcon Kind="CogOutline" Width="18" Height="18" />
              </Button>
            </StackPanel>
            <Button Name="ShowAreaButton" Classes="primary" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,34">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <mi:MaterialIcon Kind="ImageMultipleOutline" />
                <TextBlock Name="ShowAreaText" l:Tr.Text="Show photos in this area" />
              </StackPanel>
            </Button>
          </Panel>
          <Border Grid.Column="1" Width="392" Margin="12,0,0,0" CornerRadius="18" Classes="card" Padding="0" IsVisible="{Binding ShowMapPanel}">
            <DockPanel>
              <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="16,12,8,8">
                <mi:MaterialIcon Kind="ImageMultipleOutline" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding MapPanelTitle}" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" Classes="ghost icon" Command="{Binding CloseMapPanelCommand}" l:Tr.Tip="Close">
                  <mi:MaterialIcon Kind="Close" Width="20" Height="20" />
                </Button>
              </Grid>
              <ListBox Name="MapPanelGrid" Classes="grid" ItemsSource="{Binding MapPanelRows}" Margin="12,0,8,12"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
          </Border>
        </Grid>

        <!-- Albums / people / places / map: loading and messages -->
        <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoadingCollection}">
          <mi:MaterialIcon Kind="Loading" Classes="spin" Width="28" Height="28" Foreground="{DynamicResource AppPrimaryBrush}" />
        </StackPanel>
        <TextBlock Classes="secondary" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                   Text="{Binding CollectionMessage}" IsVisible="{Binding ShowAlbums}" />
        <TextBlock Classes="secondary" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                   Text="{Binding CollectionMessage}" IsVisible="{Binding ShowMap}" />
      </Panel>
    </DockPanel>

    <!-- Viewer -->
    <Panel Name="ViewerLayer" IsVisible="{Binding Viewer, Converter={x:Static ObjectConverters.IsNotNull}}" Background="Black" Focusable="True">
      <DockPanel DataContext="{Binding Viewer}" x:DataType="vm:PhotoViewerViewModel">
        <!-- Info panel: one row per fact, each with its icon (like Immich's) -->
        <Border DockPanel.Dock="Right" Width="340" Background="#161616" BorderBrush="#26FFFFFF" BorderThickness="1,0,0,0" IsVisible="{Binding ShowInfo}">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,72,14,8">
              <TextBlock l:Tr.Text="Info" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="viewerNav" Width="36" Height="36" Command="{Binding ToggleInfoCommand}" l:Tr.Tip="Close" AutomationProperties.Name="Close info">
                <mi:MaterialIcon Kind="Close" Width="20" Height="20" />
              </Button>
            </Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="24,8,24,24" Spacing="20">
                <TextBlock Classes="infoValue" Text="{Binding Description}" FontStyle="Italic"
                           IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <StackPanel Spacing="10" IsVisible="{Binding PeopleList.Count}">
                  <TextBlock Classes="infoHeading" l:Tr.Text="People" />
                  <ItemsControl ItemsSource="{Binding PeopleList}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Border Background="#26FFFFFF" CornerRadius="999" Padding="12,5" Margin="0,0,6,6">
                          <TextBlock Text="{Binding}" Foreground="White" FontSize="13" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="16">
                  <TextBlock Classes="infoHeading" l:Tr.Text="Details" />
                  <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding DateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <mi:MaterialIcon Classes="infoIcon" Kind="CalendarBlankOutline" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Classes="infoValue" Text="{Binding DateText}" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding FileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <mi:MaterialIcon Classes="infoIcon" Kind="ImageOutline" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <SelectableTextBlock Classes="infoValue" Text="{Binding FileName}" />
                      <TextBlock Classes="infoLabel" Text="{Binding Dimensions}" IsVisible="{Binding Dimensions, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding Camera, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <mi:MaterialIcon Classes="infoIcon" Kind="CameraOutline" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Classes="infoValue" Text="{Binding Camera}" />
                      <TextBlock Classes="infoLabel" Text="{Binding Lens}" IsVisible="{Binding Lens, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <TextBlock Classes="infoLabel" Text="{Binding Exposure}" IsVisible="{Binding Exposure, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding Place, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <mi:MaterialIcon Classes="infoIcon" Kind="MapMarkerOutline" />
                    <TextBlock Grid.Column="1" Classes="infoValue" Text="{Binding Place}" />
                  </Grid>
                </StackPanel>

                <!-- Public links to this photo (and a way to manage them) -->
                <StackPanel Spacing="10" IsVisible="{Binding IsShared}">
                  <TextBlock Classes="infoHeading" l:Tr.Text="Sharing" />
                  <ItemsControl ItemsSource="{Binding ShareLinks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SharedLinkViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                          <mi:MaterialIcon Classes="infoIcon" Kind="LinkVariant" />
                          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="infoValue" Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock Classes="infoLabel" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Classes="viewerNav" Width="32" Height="32" Command="{Binding CopyCommand}" l:Tr.Tip="Copy link" AutomationProperties.Name="Copy link">
                              <mi:MaterialIcon Kind="ContentCopy" Width="16" Height="16" />
                            </Button>
                            <Button Classes="viewerNav" Width="32" Height="32" Command="{Binding DeleteCommand}" l:Tr.Tip="Delete link" AutomationProperties.Name="Delete link">
                              <mi:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" />
                            </Button>
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <Panel>
          <!-- The photo: scroll to zoom, drag to move when zoomed, double-click to zoom in/out -->
          <Panel Name="ViewerStage" Margin="64,64,64,20" ClipToBounds="True" Background="Transparent">
            <Panel.ContextMenu>
              <ContextMenu Opening="OnViewerMenuOpening">
                <MenuItem l:Tr.Header="Copy picture" Command="{Binding CopyImageCommand}" IsVisible="{Binding !IsVideo}"><MenuItem.Icon><mi:MaterialIcon Kind="ContentCopy" /></MenuItem.Icon></MenuItem>
                <MenuItem l:Tr.Header="Edit" Command="{Binding EditPictureCommand}" IsVisible="{Binding CanEditPicture}"><MenuItem.Icon><mi:MaterialIcon Kind="TuneVariant" /></MenuItem.Icon></MenuItem>
                <MenuItem l:Tr.Header="Info" Command="{Binding ToggleInfoCommand}"><MenuItem.Icon><mi:MaterialIcon Kind="InformationOutline" /></MenuItem.Icon></MenuItem>
                <Separator />
                <MenuItem l:Tr.Header="Add to album" Command="{Binding AddToAlbumCommand}"><MenuItem.Icon><mi:MaterialIcon Kind="Plus" /></MenuItem.Icon></MenuItem>
                <MenuItem l:Tr.Header="Share" Command="{Binding ShareCommand}"><MenuItem.Icon><mi:MaterialIcon Kind="ShareVariantOutline" /></MenuItem.Icon></MenuItem>
                <MenuItem l:Tr.Header="Download" Command="{Binding DownloadCommand}"><MenuItem.Icon><mi:MaterialIcon Kind="TrayArrowDown" /></MenuItem.Icon></MenuItem>
                <Separator />
                <MenuItem l:Tr.Header="Move to trash" Command="{Binding TrashCommand}"><MenuItem.Icon><mi:MaterialIcon Kind="TrashCanOutline" /></MenuItem.Icon></MenuItem>
              </ContextMenu>
            </Panel.ContextMenu>
            <Image Name="ViewerImage" Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <!-- The playing video, drawn over its preview once the first frame arrives -->
            <Panel Background="Black" IsVisible="{Binding HasVideoFrame}">
              <Image Name="VideoSurface" Source="{Binding VideoFrame}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="MediumQuality" />
            </Panel>
            <!-- libmpv draws the video here directly on the graphics card -->
            <c:MpvVideoView Player="{Binding MpvVideo}" IsVisible="{Binding HasMpvVideo}" />
          </Panel>
          <mi:MaterialIcon Kind="Loading" Classes="spin" Width="28" Height="28" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <mi:MaterialIcon.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="IsLoading" />
                <Binding Path="!IsVideoLoading" />
              </MultiBinding>
            </mi:MaterialIcon.IsVisible>
          </mi:MaterialIcon>
          <!-- Video: waiting for the first frame, and what it's waiting on -->
          <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18,14" CornerRadius="14" Background="#99000000" MaxWidth="360"
                  IsVisible="{Binding IsVideoLoading}" IsHitTestVisible="False">
            <StackPanel Spacing="10">
              <mi:MaterialIcon Kind="Loading" Classes="spin" Width="28" Height="28" Foreground="White" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding VideoLoadingText}" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
          </Border>
          <!-- Video: big play button (paused or not started) -->
          <Button Classes="playVideo" Command="{Binding PlayPauseCommand}" HorizontalAlignment="Center" VerticalAlignment="Center"
                  l:Tr.Tip="Play (Space)">
            <Button.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="ShowBigPlay" />
                <Binding Path="CanPlayHere" />
              </MultiBinding>
            </Button.IsVisible>
            <mi:MaterialIcon Kind="Play" Width="40" Height="40" Foreground="White" />
          </Button>
          <!-- Video: can't play here, offer the PC's player -->
          <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18,14" CornerRadius="14" Background="#CC000000" MaxWidth="420"
                  IsVisible="{Binding !CanPlayHere}">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding VideoError}" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" />
              <Button Classes="primary" HorizontalAlignment="Center" Command="{Binding OpenInVideoPlayerCommand}" IsEnabled="{Binding !IsFetchingVideo}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <mi:MaterialIcon Kind="Loading" Classes="spin" Width="16" Height="16" IsVisible="{Binding IsFetchingVideo}" />
                  <TextBlock Text="{Binding VideoProgress}" IsVisible="{Binding IsFetchingVideo}" />
                  <TextBlock l:Tr.Text="Open in video player" IsVisible="{Binding !IsFetchingVideo}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
          <!-- Video: controls -->
          <Border Name="VideoControls" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="40,0,40,14" Padding="10,0,10,2" CornerRadius="12" Background="#B3000000"
                  MaxWidth="560" IsVisible="{Binding ShowVideoControlsNow}">
            <StackPanel Spacing="0">
              <!-- Progress bar: press and drag; pictures from the video where you point -->
              <Panel>
                <c:VideoSeekBar Name="VideoSeek" Value="{Binding VideoPosition}" />
                <Border Name="VideoPreview" IsVisible="{Binding ShowPreview}" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="0,-142,0,0" Padding="4" CornerRadius="10" Background="#E6000000">
                  <StackPanel Spacing="4">
                    <Border Name="VideoPreviewBox" Width="176" Height="99" CornerRadius="6" ClipToBounds="True" Background="#FF101010">
                      <Image Name="VideoPreviewImage" Source="{Binding PreviewFrame}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="MediumQuality" />
                    </Border>
                    <TextBlock Text="{Binding PreviewTimeText}" Foreground="White" FontSize="12.5" HorizontalAlignment="Center" FontFeatures="tnum" />
                  </StackPanel>
                </Border>
              </Panel>
              <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" VerticalAlignment="Center">
                <Button Classes="videoControl" Command="{Binding PlayPauseCommand}" l:Tr.Tip="Play or pause (Space)" AutomationProperties.Name="Play or pause">
                  <Panel>
                    <mi:MaterialIcon Kind="Pause" IsVisible="{Binding IsVideoPlaying}" />
                    <mi:MaterialIcon Kind="Play" IsVisible="{Binding !IsVideoPlaying}" />
                  </Panel>
                </Button>
                <Button Grid.Column="1" Classes="videoControl" Command="{Binding SkipBackCommand}" l:Tr.Tip="Back 10 seconds" AutomationProperties.Name="Back 10 seconds">
                  <mi:MaterialIcon Kind="Rewind10" />
                </Button>
                <Button Grid.Column="2" Classes="videoControl" Command="{Binding SkipForwardCommand}" l:Tr.Tip="Forward 10 seconds" AutomationProperties.Name="Forward 10 seconds">
                  <mi:MaterialIcon Kind="FastForward10" />
                </Button>
                <TextBlock Grid.Column="3" Text="{Binding VideoTimeText}" Foreground="White" FontSize="12.5" VerticalAlignment="Center" Margin="10,0,0,0"
                           FontFeatures="tnum" />
                <!-- Volume: the speaker mutes, the slider sets the level -->
                <Button Grid.Column="5" Classes="videoControl" Command="{Binding ToggleMuteCommand}" l:Tr.Tip="Mute (M)" AutomationProperties.Name="Mute">
                  <mi:MaterialIcon Kind="{Binding VolumeIcon}" />
                </Button>
                <Slider Grid.Column="6" Classes="videoSeek" Width="80" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                        Value="{Binding Volume}" VerticalAlignment="Center" Margin="2,0,6,0" l:Tr.Tip="Volume (Up and Down arrows)" AutomationProperties.Name="Volume" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Top bar -->
          <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Top" Margin="14,12">
            <Button Classes="viewerNav" Command="{Binding CloseCommand}" l:Tr.Tip="Close (Esc)">
              <mi:MaterialIcon Kind="Close" />
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0" Spacing="12" VerticalAlignment="Center">
              <!-- This photo has public links: click to see and manage them (in the info panel) -->
              <Button Classes="sharedChip" Command="{Binding ShowSharingCommand}" IsVisible="{Binding IsShared}"
                      l:Tr.Tip="Shared by link: see or delete the links" AutomationProperties.Name="{Binding SharedText}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <mi:MaterialIcon Kind="LinkVariant" Width="16" Height="16" />
                  <TextBlock Text="{Binding SharedText}" FontSize="13" />
                </StackPanel>
              </Button>
              <TextBlock VerticalAlignment="Center" Text="{Binding Error}" Foreground="#FFB4B4" FontSize="12.5"
                         TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
              <Button Classes="viewerNav" Command="{Binding PlayLivePhotoCommand}" IsVisible="{Binding CanPlayLive}" l:Tr.Tip="Play the live photo">
                <Panel>
                  <mi:MaterialIcon Kind="MotionPauseOutline" IsVisible="{Binding IsLiveMotion}" />
                  <mi:MaterialIcon Kind="MotionPlayOutline" IsVisible="{Binding !IsLiveMotion}" />
                </Panel>
              </Button>
              <Button Classes="viewerNav" Command="{Binding OpenStackCommand}" IsVisible="{Binding IsStack}" ToolTip.Tip="{Binding StackTip}">
                <mi:MaterialIcon Kind="LayersOutline" />
              </Button>
              <Button Classes="viewerNav" Command="{Binding ToggleFavoriteCommand}" IsVisible="{Binding CanEdit}" l:Tr.Tip="Favorite (F)">
                <Panel>
                  <mi:MaterialIcon Kind="Heart" IsVisible="{Binding IsFavorite}" />
                  <mi:MaterialIcon Kind="HeartOutline" IsVisible="{Binding !IsFavorite}" />
                </Panel>
              </Button>
              <Button Classes="viewerNav" Command="{Binding ShowInFolderCommand}" IsVisible="{Binding IsOnDevice}" l:Tr.Tip="Show in folder">
                <mi:MaterialIcon Kind="FolderOpenOutline" />
              </Button>
              <Button Classes="viewerNav" Command="{Binding CopyImageCommand}" IsVisible="{Binding !IsVideo}" l:Tr.Tip="Copy picture (Ctrl+C)">
                <mi:MaterialIcon Kind="ContentCopy" />
              </Button>
              <Button Classes="viewerNav" Command="{Binding ShareCommand}" IsVisible="{Binding CanEdit}" l:Tr.Tip="Share">
                <mi:MaterialIcon Kind="ShareVariantOutline" />
              </Button>
              <Button Classes="viewerNav" Command="{Binding AddToAlbumCommand}" IsVisible="{Binding CanEdit}" l:Tr.Tip="Add to album">
                <mi:MaterialIcon Kind="ImagePlusOutline" />
              </Button>
              <Button Classes="viewerNav" Command="{Binding DownloadCommand}" IsVisible="{Binding CanEdit}" l:Tr.Tip="Download">
                <mi:MaterialIcon Kind="TrayArrowDown" />
              </Button>
              <Button Classes="viewerNav" Command="{Binding ToggleInfoCommand}" IsVisible="{Binding IsInImmich}" l:Tr.Tip="Info (I)">
                <mi:MaterialIcon Kind="InformationOutline" />
              </Button>
              <Button Classes="viewerNav" Command="{Binding TrashCommand}" IsVisible="{Binding CanEdit}" l:Tr.Tip="Move to trash (Delete)">
                <mi:MaterialIcon Kind="TrashCanOutline" />
              </Button>
              <Button Classes="viewerNav" Command="{Binding EditPictureCommand}" IsVisible="{Binding CanEditPicture}" l:Tr.Tip="Edit" AutomationProperties.Name="Edit">
                <mi:MaterialIcon Kind="TuneVariant" />
              </Button>
              <Button Name="ViewerMoreButton" Classes="viewerNav" IsVisible="{Binding CanEdit}" l:Tr.Tip="More" AutomationProperties.Name="More">
                <mi:MaterialIcon Kind="DotsVertical" />
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{Binding IsSlideshow, Converter={x:Static vm:Converters.SlideshowText}}" Command="{Binding ToggleSlideshowCommand}">
                      <MenuItem.Icon><mi:MaterialIcon Kind="PresentationPlay" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem l:Tr.Header="Download" Command="{Binding DownloadCommand}"><MenuItem.Icon><mi:MaterialIcon Kind="TrayArrowDown" /></MenuItem.Icon></MenuItem>
                    <MenuItem l:Tr.Header="Add to album" Command="{Binding AddToAlbumCommand}"><MenuItem.Icon><mi:MaterialIcon Kind="Plus" /></MenuItem.Icon></MenuItem>
                    <MenuItem l:Tr.Header="Set as profile picture" Command="{Binding SetAsProfilePictureCommand}" IsVisible="{Binding !IsVideo}">
                      <MenuItem.Icon><mi:MaterialIcon Kind="AccountCircleOutline" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding InArchive, Converter={x:Static vm:Converters.ArchiveText}}" Command="{Binding ArchiveCommand}" IsVisible="{Binding CanArchive}">
                      <MenuItem.Icon><mi:MaterialIcon Kind="ArchiveOutline" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem l:Tr.Header="View in timeline" Command="{Binding ViewInTimelineCommand}"><MenuItem.Icon><mi:MaterialIcon Kind="ImageMultipleOutline" /></MenuItem.Icon></MenuItem>
                    <MenuItem l:Tr.Header="View similar photos" Command="{Binding ViewSimilarCommand}" IsVisible="{Binding !IsVideo}">
                      <MenuItem.Icon><mi:MaterialIcon Kind="ImageSearchOutline" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding InLockedFolder, Converter={x:Static vm:Converters.LockedText}}" Command="{Binding MoveToLockedCommand}">
                      <MenuItem.Icon><mi:MaterialIcon Kind="LockOutline" /></MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem l:Tr.Header="Refresh faces" Command="{Binding RefreshFacesCommand}" IsVisible="{Binding !IsVideo}">
                      <MenuItem.Icon><mi:MaterialIcon Kind="FaceRecognition" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem l:Tr.Header="Refresh metadata" Command="{Binding RefreshMetadataCommand}"><MenuItem.Icon><mi:MaterialIcon Kind="DatabaseRefreshOutline" /></MenuItem.Icon></MenuItem>
                    <MenuItem l:Tr.Header="Refresh thumbnails" Command="{Binding RefreshThumbnailsCommand}"><MenuItem.Icon><mi:MaterialIcon Kind="ImageRefreshOutline" /></MenuItem.Icon></MenuItem>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
              <Button Classes="viewerNav" Command="{Binding OpenInImmichCommand}" IsVisible="{Binding IsInImmich}"
                      ToolTip.Tip="{Binding IsVideo, Converter={x:Static vm:Converters.VideoOpenText}}">
                <mi:MaterialIcon Kind="OpenInNew" />
              </Button>
              <Button Classes="viewerNav" Command="{Binding OpenFileCommand}" IsVisible="{Binding IsLocalOnly}" l:Tr.Tip="Open file">
                <mi:MaterialIcon Kind="OpenInNew" />
              </Button>
            </StackPanel>
          </Grid>

          <!-- Date (and for files only on this PC, their backup status), under the photo -->
          <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Padding="12,5" CornerRadius="10" Background="#99000000"
                  IsHitTestVisible="False" IsVisible="{Binding DateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding DateText}" Foreground="White" FontWeight="Medium" FontSize="13" />
              <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding IsLocalOnly}">
                <mi:MaterialIcon Kind="CloudUploadOutline" Width="15" Height="15" Foreground="#FFD9A0" />
                <TextBlock Text="{Binding LocalStatus}" Foreground="#FFD9A0" FontSize="12.5" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Button Classes="viewerNav" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0"
                  Command="{Binding PreviousCommand}" l:Tr.Tip="Newer (←)">
            <mi:MaterialIcon Kind="ChevronLeft" Width="28" Height="28" />
          </Button>
          <Button Classes="viewerNav" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0"
                  Command="{Binding NextCommand}" l:Tr.Tip="Older (→)">
            <mi:MaterialIcon Kind="ChevronRight" Width="28" Height="28" />
          </Button>
        </Panel>
      </DockPanel>
    </Panel>

    <!-- Share / add to album panel -->
    <p:SharePanel IsVisible="{Binding Panel, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <!-- Toasts: over everything, including the viewer -->
    <ItemsControl ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" ZIndex="50"
                  Focusable="False">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ToastViewModel">
          <Button Classes="toast" Command="{Binding $parent[ItemsControl].((vm:PhotosViewModel)DataContext).DismissToastCommand}" CommandParameter="{Binding}"
                  HorizontalAlignment="Right" AutomationProperties.Name="{Binding Text}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <mi:MaterialIcon Kind="{Binding Icon}" Width="20" Height="20" Classes.spin="{Binding Spins}" Foreground="{DynamicResource AppPageBrush}" />
              <TextBlock Text="{Binding Text}" Foreground="{DynamicResource AppPageBrush}" FontWeight="Medium" TextWrapping="Wrap" MaxWidth="360" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Panel>
</UserControl>
