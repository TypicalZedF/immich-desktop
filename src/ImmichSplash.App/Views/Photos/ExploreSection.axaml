<!-- Explore: people and places. Part of PhotosView. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ImmichSplash.App.Services"
             xmlns:vm="using:ImmichSplash.App.ViewModels"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="ImmichSplash.App.Views.Photos.ExploreSection"
             x:DataType="vm:PhotosViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="28,4,10,24">
    <StackPanel Spacing="10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="h3" l:Tr.Text="People" />
        <Button Grid.Column="1" Classes="link" l:Tr.Content="Show all" Command="{Binding ShowAllPeopleCommand}" IsVisible="{Binding HasMorePeople}" />
      </Grid>
      <TextBlock Classes="secondary" Text="{Binding PeopleMessage}" TextWrapping="Wrap"
                 IsVisible="{Binding PeopleMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <ItemsControl ItemsSource="{Binding People}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PersonCardViewModel">
            <StackPanel Width="120" Spacing="4" Margin="0,0,8,8">
              <Button Classes="cover" Width="120" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Title}">
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem l:Tr.Header="Open" Command="{Binding OpenCommand}" />
                    <MenuItem Header="{Binding NameActionText}" Command="{Binding NameCommand}" />
                    <MenuItem l:Tr.Header="Discard this face" Command="{Binding DiscardCommand}" />
                  </ContextMenu>
                </Button.ContextMenu>
                <Border Classes="coverImage" Width="120" Height="120" CornerRadius="60" ClipToBounds="True" Background="{DynamicResource AppNeutralSoftBrush}">
                  <Panel>
                    <mi:MaterialIcon Kind="AccountOutline" Width="40" Height="40" Foreground="{DynamicResource AppTextTertiaryBrush}" />
                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                  </Panel>
                </Border>
              </Button>
              <!-- Named: the name. Unnamed: a way to give one (the tile itself opens their photos). -->
              <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" IsVisible="{Binding IsNamed}" />
              <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" IsVisible="{Binding !IsNamed}">
                <Button Classes="link" Command="{Binding NameCommand}" l:Tr.Content="Add a name" />
                <Button Classes="link" Command="{Binding DiscardCommand}" l:Tr.Content="Discard" l:Tr.Tip="Forget this face (the photos stay)" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
        <TextBlock Classes="h3" l:Tr.Text="Places" />
        <Button Grid.Column="1" Classes="link" l:Tr.Content="Show all" Command="{Binding ShowAllPlacesCommand}" IsVisible="{Binding HasMorePlaces}" />
      </Grid>
      <TextBlock Classes="secondary" Text="{Binding PlacesMessage}" TextWrapping="Wrap"
                 IsVisible="{Binding PlacesMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <ItemsControl ItemsSource="{Binding Places}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PlaceCardViewModel">
            <Button Classes="cover" Width="176" Command="{Binding OpenCommand}">
              <Border Classes="coverImage" Width="176" Height="176" CornerRadius="16" ClipToBounds="True" Background="{DynamicResource AppNeutralSoftBrush}">
                <Panel>
                  <mi:MaterialIcon Kind="MapMarkerOutline" Width="40" Height="40" Foreground="{DynamicResource AppTextTertiaryBrush}" />
                  <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                  <Border VerticalAlignment="Bottom" Padding="12,28,12,10">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#B3000000" Offset="1" />
                      </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Subtitle}" Foreground="#D9FFFFFF" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Border>
                </Panel>
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
