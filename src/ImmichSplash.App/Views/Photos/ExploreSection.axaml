<!-- Explore: people and places. Part of PhotosView. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ImmichSplash.App.Services"
             xmlns:vm="using:ImmichSplash.App.ViewModels"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="ImmichSplash.App.Views.Photos.ExploreSection"
             x:DataType="vm:PhotosViewModel">
  <UserControl.Styles>
    <!-- The face's discard button: small, round, only while the pointer is over the face (or it has focus). -->
    <Style Selector="Button.discard">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,2,2,0" />
      <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="StackPanel.person:pointerover Button.discard, Button.discard:focus-visible">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28,4,10,24" Spacing="10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="h3" l:Tr.Text="People" />
        <Button Grid.Column="1" Classes="link" l:Tr.Content="Show all" Command="{Binding ShowAllPeopleCommand}" IsVisible="{Binding HasMorePeople}" />
      </Grid>
      <TextBlock Classes="secondary" Text="{Binding PeopleMessage}" TextWrapping="Wrap"
                 IsVisible="{Binding PeopleMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <ItemsControl ItemsSource="{Binding People}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PersonCardViewModel">
            <!-- A face, and under it the name (or a way to give one). Discard: the x on hover, or right-click. -->
            <StackPanel Classes="person" Width="120" Spacing="8" Margin="0,0,16,20">
              <Panel>
                <Button Classes="cover" Margin="0" Width="120" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Title}">
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem l:Tr.Header="Open" Command="{Binding OpenCommand}"><MenuItem.Icon><mi:MaterialIcon Kind="ImageMultipleOutline" /></MenuItem.Icon></MenuItem>
                      <MenuItem Header="{Binding NameActionText}" Command="{Binding NameCommand}"><MenuItem.Icon><mi:MaterialIcon Kind="PencilOutline" /></MenuItem.Icon></MenuItem>
                      <MenuItem l:Tr.Header="Merge with someone…" Command="{Binding MergeCommand}"><MenuItem.Icon><mi:MaterialIcon Kind="CallMerge" /></MenuItem.Icon></MenuItem>
                      <Separator />
                      <MenuItem l:Tr.Header="Discard this face" Command="{Binding DiscardCommand}"><MenuItem.Icon><mi:MaterialIcon Kind="CloseCircleOutline" /></MenuItem.Icon></MenuItem>
                    </ContextMenu>
                  </Button.ContextMenu>
                  <Border Classes="coverImage" Width="120" Height="120" CornerRadius="60" ClipToBounds="True" Background="{DynamicResource AppNeutralSoftBrush}">
                    <Panel>
                      <mi:MaterialIcon Kind="AccountOutline" Width="40" Height="40" Foreground="{DynamicResource AppTextTertiaryBrush}" />
                      <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                    </Panel>
                  </Border>
                </Button>
                <Button Classes="discard" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding DiscardCommand}"
                        l:Tr.Tip="Forget this face (the photos stay)" AutomationProperties.Name="Discard this face">
                  <mi:MaterialIcon Kind="Close" Width="14" Height="14" />
                </Button>
              </Panel>
              <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" IsVisible="{Binding IsNamed}" />
              <Button Classes="link" HorizontalAlignment="Center" FontSize="13" Command="{Binding NameCommand}" l:Tr.Content="Add a name" IsVisible="{Binding !IsNamed}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
        <TextBlock Classes="h3" l:Tr.Text="Places" />
        <Button Grid.Column="1" Classes="link" l:Tr.Content="Show all" Command="{Binding ShowAllPlacesCommand}" IsVisible="{Binding HasMorePlaces}" />
      </Grid>
      <TextBlock Classes="secondary" Text="{Binding PlacesMessage}" TextWrapping="Wrap"
                 IsVisible="{Binding PlacesMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <ItemsControl ItemsSource="{Binding Places}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PlaceCardViewModel">
            <Button Classes="cover" Width="176" Command="{Binding OpenCommand}">
              <Border Classes="coverImage" Width="176" Height="176" CornerRadius="16" ClipToBounds="True" Background="{DynamicResource AppNeutralSoftBrush}">
                <Panel>
                  <mi:MaterialIcon Kind="MapMarkerOutline" Width="40" Height="40" Foreground="{DynamicResource AppTextTertiaryBrush}" />
                  <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                  <Border VerticalAlignment="Bottom" Padding="12,28,12,10">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#B3000000" Offset="1" />
                      </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Subtitle}" Foreground="#D9FFFFFF" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Border>
                </Panel>
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
