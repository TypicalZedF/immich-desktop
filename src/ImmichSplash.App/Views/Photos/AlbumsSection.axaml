<!-- The Albums page: your albums as cover cards. Part of PhotosView. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ImmichSplash.App.Services"
             xmlns:vm="using:ImmichSplash.App.ViewModels"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="ImmichSplash.App.Views.Photos.AlbumsSection"
             x:DataType="vm:PhotosViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="28,8,10,24">
    <ItemsControl ItemsSource="{Binding Albums}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:AlbumCardViewModel">
          <Button Classes="cover" Width="196" Command="{Binding OpenCommand}">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem l:Tr.Header="Open" Command="{Binding OpenCommand}" />
                <MenuItem l:Tr.Header="Delete album" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" />
              </ContextMenu>
            </Button.ContextMenu>
            <StackPanel Spacing="8">
              <Border Classes="coverImage" Width="196" Height="196" CornerRadius="16" ClipToBounds="True" Background="{DynamicResource AppNeutralSoftBrush}">
                <Panel>
                  <mi:MaterialIcon Kind="ImageAlbum" Width="40" Height="40" Foreground="{DynamicResource AppTextTertiaryBrush}" />
                  <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                </Panel>
              </Border>
              <StackPanel Spacing="1" Margin="2,0">
                <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="caption" Text="{Binding Subtitle}" />
              </StackPanel>
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
