<!-- The Albums page: filter, search, sort, group by year, create/edit, cover cards or a list. Part of PhotosView. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ImmichSplash.App.Services"
             xmlns:vm="using:ImmichSplash.App.ViewModels"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="ImmichSplash.App.Views.Photos.AlbumsSection"
             x:DataType="vm:PhotosViewModel">
  <UserControl.Styles>
    <!-- A quiet on/off button: only a soft background when it's on (no loud colour) -->
    <Style Selector="ToggleButton.toolToggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton.toolToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="ToggleButton.toolToggle:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppNeutralSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="ToggleButton.toolToggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    </Style>
    <Style Selector="Border.toolbarDivider">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="Background" Value="{DynamicResource AppDividerBrush}" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <!-- Toolbar: what you look at on the left (filter, search); what you do and how it's arranged on the right.
         On a narrow window the right side drops to its own line, still on the right. -->
    <Grid Name="Toolbar" DockPanel.Dock="Top" Margin="28,4,10,10" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
      <StackPanel Name="ToolbarLeft" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,0,16,0">
        <Border Classes="segmented" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <RadioButton Classes="segment" GroupName="albumFilter" l:Tr.Content="All" IsChecked="{Binding IsFilterAll, Mode=OneWay}" Command="{Binding ShowAllAlbumsCommand}" />
            <RadioButton Classes="segment" GroupName="albumFilter" l:Tr.Content="Owned" IsChecked="{Binding IsFilterOwned, Mode=OneWay}" Command="{Binding ShowOwnedAlbumsCommand}" />
            <RadioButton Classes="segment" GroupName="albumFilter" l:Tr.Content="Shared" IsChecked="{Binding IsFilterShared, Mode=OneWay}" Command="{Binding ShowSharedAlbumsCommand}" />
          </StackPanel>
        </Border>
        <TextBox Width="240" Text="{Binding AlbumSearchText}" l:Tr.Watermark="Search albums" VerticalAlignment="Center" AutomationProperties.Name="Search albums" />
      </StackPanel>

      <StackPanel Name="ToolbarRight" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
        <Button Classes="secondary" Command="{Binding CreateAlbumCommand}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
            <TextBlock l:Tr.Text="Create album" />
          </StackPanel>
        </Button>

        <Border Classes="toolbarDivider" />

        <Button Classes="ghost icon" Command="{Binding ToggleAlbumSortDirectionCommand}" l:Tr.Tip="Reverse the order" AutomationProperties.Name="Reverse the order">
          <mi:MaterialIcon Kind="{Binding AlbumSortIcon}" Width="18" Height="18" />
        </Button>
        <ComboBox ItemsSource="{Binding AlbumSortChoices}" SelectedItem="{Binding SelectedAlbumSort}" MinWidth="170" VerticalAlignment="Center" AutomationProperties.Name="Sort albums">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AlbumSortChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <Border Classes="toolbarDivider" />

        <ToggleButton Classes="toolToggle" IsChecked="{Binding AlbumGroupByYear}" VerticalAlignment="Center" l:Tr.Tip="Group the albums by year">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="CalendarMonthOutline" Width="18" Height="18" />
            <TextBlock l:Tr.Text="Group by year" />
          </StackPanel>
        </ToggleButton>
        <Button Classes="ghost icon" Command="{Binding ExpandAllAlbumGroupsCommand}" IsVisible="{Binding AlbumGroupByYear}" l:Tr.Tip="Expand all years" AutomationProperties.Name="Expand all years">
          <mi:MaterialIcon Kind="UnfoldMoreHorizontal" Width="18" Height="18" />
        </Button>
        <Button Classes="ghost icon" Command="{Binding CollapseAllAlbumGroupsCommand}" IsVisible="{Binding AlbumGroupByYear}" l:Tr.Tip="Collapse all years" AutomationProperties.Name="Collapse all years">
          <mi:MaterialIcon Kind="UnfoldLessHorizontal" Width="18" Height="18" />
        </Button>

        <Border Classes="toolbarDivider" />

        <Button Classes="ghost icon" Command="{Binding ToggleAlbumViewCommand}" l:Tr.Tip="Switch between cover cards and a list" AutomationProperties.Name="Switch between cover cards and a list">
          <mi:MaterialIcon Kind="{Binding AlbumViewIcon}" Width="18" Height="18" />
        </Button>
      </StackPanel>
    </Grid>

    <TextBlock DockPanel.Dock="Top" Classes="secondary" Margin="28,12,10,0" Text="{Binding AlbumsEmptyText}"
               IsVisible="{Binding AlbumsEmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="28,0,10,24">
      <ItemsControl ItemsSource="{Binding AlbumGroups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AlbumGroupViewModel">
            <StackPanel Spacing="8" Margin="0,0,0,14">
              <!-- Year heading -->
              <Button Classes="ghost" Command="{Binding ToggleCommand}" IsVisible="{Binding ShowHeader}" HorizontalAlignment="Left" Padding="4,2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <mi:MaterialIcon Kind="ChevronDown" Width="20" Height="20" IsVisible="{Binding IsExpanded}" />
                  <mi:MaterialIcon Kind="ChevronRight" Width="20" Height="20" IsVisible="{Binding !IsExpanded}" />
                  <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Classes="secondary" Text="{Binding CountText}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <!-- Cover cards -->
              <ItemsControl ItemsSource="{Binding Albums}" IsVisible="{Binding IsGridOpen}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AlbumCardViewModel">
                    <Button Classes="cover" Width="196" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Title}">
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem l:Tr.Header="Open" Command="{Binding OpenCommand}" />
                          <MenuItem l:Tr.Header="Edit album" Command="{Binding EditCommand}" IsVisible="{Binding CanDelete}" />
                          <MenuItem l:Tr.Header="Share" Command="{Binding ShareCommand}" IsVisible="{Binding CanDelete}" />
                          <MenuItem l:Tr.Header="Download" Command="{Binding DownloadCommand}" />
                          <MenuItem l:Tr.Header="Delete album" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <StackPanel Spacing="8">
                        <Border Classes="coverImage" Width="196" Height="196" CornerRadius="16" ClipToBounds="True" Background="{DynamicResource AppNeutralSoftBrush}">
                          <Panel>
                            <mi:MaterialIcon Kind="ImageAlbum" Width="40" Height="40" Foreground="{DynamicResource AppTextTertiaryBrush}" />
                            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                          </Panel>
                        </Border>
                        <StackPanel Spacing="1" Margin="2,0">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="caption" Text="{Binding DateText}" IsVisible="{Binding HasDateText}" />
                          <TextBlock Classes="caption" Text="{Binding Meta}" />
                        </StackPanel>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- List rows -->
              <ItemsControl ItemsSource="{Binding Albums}" IsVisible="{Binding IsListOpen}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AlbumCardViewModel">
                    <Button Classes="cover" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding OpenCommand}"
                            AutomationProperties.Name="{Binding Title}">
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem l:Tr.Header="Open" Command="{Binding OpenCommand}" />
                          <MenuItem l:Tr.Header="Edit album" Command="{Binding EditCommand}" IsVisible="{Binding CanDelete}" />
                          <MenuItem l:Tr.Header="Share" Command="{Binding ShareCommand}" IsVisible="{Binding CanDelete}" />
                          <MenuItem l:Tr.Header="Download" Command="{Binding DownloadCommand}" />
                          <MenuItem l:Tr.Header="Delete album" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="2,4">
                        <Border Classes="coverImage" Width="56" Height="56" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource AppNeutralSoftBrush}">
                          <Panel>
                            <mi:MaterialIcon Kind="ImageAlbum" Width="22" Height="22" Foreground="{DynamicResource AppTextTertiaryBrush}" />
                            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                          </Panel>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="1">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="caption" Text="{Binding DateText}" IsVisible="{Binding HasDateText}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Classes="secondary" Text="{Binding Meta}" VerticalAlignment="Center" Margin="0,0,16,0" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
