<!-- Utilities, laid out like the Immich web app's. Part of PhotosView. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ImmichSplash.App.Services"
             xmlns:vm="using:ImmichSplash.App.ViewModels"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="ImmichSplash.App.Views.Photos.UtilitiesSection"
             x:DataType="vm:PhotosViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28,4,10,24" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
      <Border Classes="card" Padding="8,14,8,8" CornerRadius="20">
        <StackPanel Spacing="2">
          <TextBlock Classes="caption" l:Tr.Text="Organize your library" Margin="14,0,0,6" />
          <Button Classes="utility" Command="{Binding OpenDuplicatesCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <mi:MaterialIcon Kind="ContentDuplicate" Classes="utilityIcon" />
              <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                <TextBlock l:Tr.Text="Review duplicates" FontWeight="Medium" />
                <TextBlock Classes="caption" Text="{Binding DuplicatesText}" TextWrapping="Wrap" />
              </StackPanel>
              <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" Foreground="{DynamicResource AppTextTertiaryBrush}" />
            </Grid>
          </Button>
          <Button Classes="utility" Command="{Binding OpenScreenCapturesCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <mi:MaterialIcon Kind="Monitor" Classes="utilityIcon" />
              <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                <TextBlock l:Tr.Text="Archive screenshots and screen recordings" FontWeight="Medium" />
                <TextBlock Classes="caption" l:Tr.Text="Keep them out of your timeline without deleting them." TextWrapping="Wrap" />
              </StackPanel>
              <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" Foreground="{DynamicResource AppTextTertiaryBrush}" />
            </Grid>
          </Button>
          <Button Classes="utility" Command="{Binding OpenLargeFilesCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <mi:MaterialIcon Kind="ImageSizeSelectLarge" Classes="utilityIcon" />
              <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                <TextBlock l:Tr.Text="Review large files" FontWeight="Medium" />
                <TextBlock Classes="caption" l:Tr.Text="Your biggest photos and videos, to free up space." TextWrapping="Wrap" />
              </StackPanel>
              <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" Foreground="{DynamicResource AppTextTertiaryBrush}" />
            </Grid>
          </Button>
        </StackPanel>
      </Border>
      <Border Classes="card" Padding="8,14,8,8" CornerRadius="20">
        <StackPanel Spacing="2">
          <TextBlock Classes="caption" l:Tr.Text="Privacy" Margin="14,0,0,6" />
          <Button Classes="utility" Command="{Binding OpenPrivacyCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <mi:MaterialIcon Kind="ShieldLockOutline" Classes="utilityIcon" />
              <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                <TextBlock l:Tr.Text="Suggest for the locked folder" FontWeight="Medium" />
                <TextBlock Classes="caption" Text="{Binding PrivacyText}" TextWrapping="Wrap" />
              </StackPanel>
              <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" Foreground="{DynamicResource AppTextTertiaryBrush}" />
            </Grid>
          </Button>
        </StackPanel>
      </Border>
      <Border Classes="card" Padding="8,14,8,8" CornerRadius="20">
        <StackPanel Spacing="2">
          <TextBlock Classes="caption" l:Tr.Text="This PC" Margin="14,0,0,6" />
          <Button Classes="utility" Command="{Binding OpenNotBackedUpCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <mi:MaterialIcon Kind="CloudUploadOutline" Classes="utilityIcon" />
              <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                <TextBlock l:Tr.Text="Not backed up yet" FontWeight="Medium" />
                <TextBlock Classes="caption" Text="{Binding NotBackedUpText}" TextWrapping="Wrap" />
              </StackPanel>
              <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" Foreground="{DynamicResource AppTextTertiaryBrush}" />
            </Grid>
          </Button>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
