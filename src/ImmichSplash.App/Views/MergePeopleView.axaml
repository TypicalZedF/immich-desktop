<!-- Merge a face into another person: pick who, read the warning, merge. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ImmichSplash.App.Services"
             xmlns:vm="using:ImmichSplash.App.ViewModels"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="ImmichSplash.App.Views.MergePeopleView"
             x:DataType="vm:MergePeopleViewModel">
  <UserControl.Styles>
    <Style Selector="Button.choice">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.choice.selected">
      <Setter Property="Background" Value="{DynamicResource AppPrimarySoftBrush}" />
    </Style>
  </UserControl.Styles>
  <Border Classes="card" Width="460" Padding="28,26" CornerRadius="22" HorizontalAlignment="Center" VerticalAlignment="Center"
          BoxShadow="0 18 50 0 #40000000">
    <StackPanel Spacing="14">
      <Grid ColumnDefinitions="Auto,*">
        <Border Width="48" Height="48" CornerRadius="24" ClipToBounds="True" Background="{DynamicResource AppNeutralSoftBrush}">
          <Panel>
            <mi:MaterialIcon Kind="AccountOutline" Width="24" Height="24" Foreground="{DynamicResource AppTextTertiaryBrush}" />
            <Image Source="{Binding Source.Cover}" Stretch="UniformToFill" />
          </Panel>
        </Border>
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="h2" Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock Classes="caption" l:Tr.Text="Pick who this really is. Their photos come together under one person." TextWrapping="Wrap" />
        </StackPanel>
      </Grid>

      <TextBox Name="Search" Text="{Binding SearchText}" l:Tr.Watermark="Search people" AutomationProperties.Name="Search people">
        <TextBox.InnerLeftContent>
          <mi:MaterialIcon Kind="Magnify" Width="18" Height="18" Margin="10,0,0,0" Foreground="{DynamicResource AppTextTertiaryBrush}" />
        </TextBox.InnerLeftContent>
      </TextBox>

      <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Classes="secondary" l:Tr.Text="Nobody by that name." IsVisible="{Binding IsEmpty}" Margin="8" />
          <ItemsControl ItemsSource="{Binding Choices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MergeChoiceViewModel">
                <Button Classes="choice" Classes.selected="{Binding IsSelected}"
                        Command="{Binding $parent[UserControl].((vm:MergePeopleViewModel)DataContext).PickCommand}" CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding Title}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="40" Height="40" CornerRadius="20" ClipToBounds="True" Background="{DynamicResource AppNeutralSoftBrush}">
                      <Panel>
                        <mi:MaterialIcon Kind="AccountOutline" Width="20" Height="20" Foreground="{DynamicResource AppTextTertiaryBrush}" />
                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                      </Panel>
                    </Border>
                    <TextBlock Grid.Column="1" Margin="12,0" Text="{Binding Title}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <mi:MaterialIcon Grid.Column="2" Kind="CheckCircle" Width="20" Height="20" Foreground="{DynamicResource AppPrimaryBrush}" IsVisible="{Binding IsSelected}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- The warning, once someone is picked -->
      <Border IsVisible="{Binding HasTarget}" Padding="14,12" CornerRadius="12" Background="{DynamicResource AppDangerSoftBrush}">
        <Grid ColumnDefinitions="Auto,*">
          <mi:MaterialIcon Kind="AlertOutline" Width="20" Height="20" Foreground="{DynamicResource AppDangerBrush}" VerticalAlignment="Top" />
          <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding Warning}" TextWrapping="Wrap" />
        </Grid>
      </Border>

      <TextBlock Classes="caption" Foreground="{DynamicResource AppDangerBrush}" Text="{Binding Error}" TextWrapping="Wrap"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,6,0,0">
        <Button Classes="secondary" l:Tr.Content="Cancel" Command="{Binding CancelCommand}" />
        <Button Classes="primary danger" Command="{Binding MergeCommand}" IsEnabled="{Binding CanMerge}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="Loading" Classes="spin" Width="16" Height="16" IsVisible="{Binding IsSaving}" />
            <TextBlock l:Tr.Text="Merge" />
          </StackPanel>
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
