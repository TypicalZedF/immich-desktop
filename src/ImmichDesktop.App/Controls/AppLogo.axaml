<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="ImmichDesktop.App.Controls.AppLogo">
  <Viewbox Stretch="Uniform">
    <Panel Width="64" Height="64">
      <Border Name="Tile" CornerRadius="16" Background="{StaticResource AppLogoBrush}" />
      <!-- Subtle top highlight for depth -->
      <Border CornerRadius="16">
        <Border.Background>
          <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Offset="0" Color="#26FFFFFF" />
            <GradientStop Offset="0.55" Color="#00FFFFFF" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <mi:MaterialIcon Kind="CloudUpload" Foreground="White" Width="42" Height="42" Margin="0,1,0,0" />
    </Panel>
  </Viewbox>
</UserControl>
