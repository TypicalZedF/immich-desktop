<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ImmichDesktop.App.Services"
             xmlns:vm="using:ImmichDesktop.App.ViewModels"
             xmlns:c="using:ImmichDesktop.App.Controls"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="ImmichDesktop.App.Views.ShellView"
             x:DataType="vm:ShellViewModel">
  <!-- Layout follows the Immich web app: top navigation bar, left sidebar, content. -->
  <Grid RowDefinitions="68,*" Background="{DynamicResource AppPageBrush}">

    <!-- ===== Top bar ===== -->
    <Grid ColumnDefinitions="256,*,Auto" Background="{DynamicResource AppPageBrush}">
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="24,0,0,0" VerticalAlignment="Center">
        <c:ImmichWordmark Height="34" />
        <Border Classes="chip" Padding="8,2" Background="{DynamicResource AppPrimarySoftBrush}" VerticalAlignment="Center" Margin="0,4,0,0">
          <TextBlock l:Tr.Text="DESKTOP" FontSize="10" FontWeight="Medium" LetterSpacing="1" Foreground="{DynamicResource AppPrimaryBrush}" />
        </Border>
      </StackPanel>

      <!-- Search, like the web app's top bar -->
      <TextBox Grid.Column="1" MaxWidth="560" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="8,0,24,0"
               Text="{Binding SearchText}" l:Tr.Watermark="Search your photos" CornerRadius="999" Padding="12,9">
        <TextBox.InnerLeftContent>
          <mi:MaterialIcon Kind="Magnify" Width="20" Height="20" Margin="14,0,0,0" Foreground="{DynamicResource AppTextTertiaryBrush}" />
        </TextBox.InnerLeftContent>
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
        </TextBox.KeyBindings>
      </TextBox>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="0,0,20,0" VerticalAlignment="Center">
        <Button Classes="ghost icon" Command="{Binding OpenWebCommand}" l:Tr.Tip="Open Immich in your browser">
          <mi:MaterialIcon Kind="OpenInNew" Width="20" Height="20" />
        </Button>
        <Button Classes="ghost icon" Command="{Binding LockNowCommand}" IsVisible="{Binding IsLockEnabled}" l:Tr.Tip="Lock now">
          <mi:MaterialIcon Kind="LockOutline" Width="20" Height="20" />
        </Button>
        <Button Classes="ghost icon" Command="{Binding OpenSettingsCommand}" l:Tr.Tip="Settings">
          <mi:MaterialIcon Kind="CogOutline" Width="20" Height="20" />
        </Button>
        <Button Classes="ghost icon" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{Binding ThemeTip}">
          <mi:MaterialIcon Kind="{Binding ThemeIcon}" Width="20" Height="20" />
        </Button>
        <Button Classes="ghost" Padding="4" Margin="6,0,0,0" Command="{Binding OpenAccountCommand}">
          <ToolTip.Tip>
            <StackPanel>
              <TextBlock Text="{Binding UserName}" FontWeight="Medium" />
              <TextBlock Text="{Binding UserEmail}" />
            </StackPanel>
          </ToolTip.Tip>
          <c:Avatar Width="38" Height="38" Initial="{Binding UserInitial}" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- ===== Sidebar + page ===== -->
    <Grid Grid.Row="1" ColumnDefinitions="256,*">
      <DockPanel Background="{DynamicResource AppSidebarBrush}" Margin="0,6,0,0">

        <!-- Storage and server, compact (Immich-style) -->
        <StackPanel DockPanel.Dock="Bottom" Margin="24,0,24,16" Spacing="6">
          <StackPanel Spacing="6" IsVisible="{Binding HasStorage}">
            <Grid ColumnDefinitions="Auto,*">
              <mi:MaterialIcon Kind="Cloud" Width="16" Height="16" Foreground="{DynamicResource AppTextSecondaryBrush}" />
              <TextBlock Grid.Column="1" Classes="caption" FontSize="11.5" Margin="8,0,0,0" Text="{Binding StorageText}" VerticalAlignment="Center" />
            </Grid>
            <ProgressBar Classes="thin" Value="{Binding StoragePercent}" Maximum="100" />
          </StackPanel>
          <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0" ToolTip.Tip="{Binding ServerStatusText}">
            <Panel Width="16" Height="16">
              <Ellipse Width="8" Height="8" Fill="{DynamicResource AppSuccessBrush}" IsVisible="{Binding IsServerOnline}" />
              <Ellipse Width="8" Height="8" Fill="{DynamicResource AppDangerBrush}" IsVisible="{Binding !IsServerOnline}" />
            </Panel>
            <TextBlock Grid.Column="1" Classes="caption tertiary" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
              <Run Text="{Binding ServerHost}" /><Run Text="  " /><Run Text="{Binding ServerVersion}" />
            </TextBlock>
          </Grid>
        </StackPanel>

        <!-- Live backup status (opens the Backup page) -->
        <Button DockPanel.Dock="Bottom" Margin="16,0,16,14" CornerRadius="14" Padding="12,10" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch" Background="{DynamicResource AppCardBrush}" BorderThickness="0"
                Command="{Binding ShowBackupCommand}" ToolTip.Tip="{Binding Status.Detail}">
          <Grid ColumnDefinitions="Auto,*">
            <Border Classes="tone" Width="30" Height="30" CornerRadius="15"
                    Classes.busy="{Binding Status.IsBusy}" Classes.paused="{Binding Status.IsPaused}"
                    Classes.warning="{Binding Status.IsWarning}" Classes.error="{Binding Status.IsError}">
              <mi:MaterialIcon Kind="{Binding Status.Icon}" Width="17" Height="17" Classes.spin="{Binding Status.Spin}" />
            </Border>
            <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="Medium"
                       Text="{Binding Status.Title}" TextTrimming="CharacterEllipsis" />
          </Grid>
        </Button>

        <!-- Navigation: library sections, the Library group, this PC's backup, settings -->
        <ListBox Name="Nav" Classes="nav" ItemsSource="{Binding NavEntries}" SelectedItem="{Binding SelectedNav}">
          <ListBox.DataTemplates>
            <DataTemplate DataType="vm:NavHeader">
              <Panel>
                <TextBlock Text="{Binding Title}" IsVisible="{Binding !IsDivider}" FontSize="11.5" FontWeight="SemiBold" LetterSpacing="0.6"
                           Foreground="{DynamicResource AppTextTertiaryBrush}" />
                <Border Classes="divider" IsVisible="{Binding IsDivider}" Margin="0,4,0,0" />
              </Panel>
            </DataTemplate>
            <DataTemplate DataType="vm:NavItem">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <Panel Width="20" Height="20">
                  <mi:MaterialIcon Classes="inactive" Kind="{Binding Icon}" Width="20" Height="20" />
                  <mi:MaterialIcon Classes="active" Kind="{Binding ActiveIcon}" Width="20" Height="20" />
                </Panel>
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>
      </DockPanel>

      <TransitioningContentControl Grid.Column="1" Content="{Binding CurrentPage}">
        <TransitioningContentControl.PageTransition>
          <CrossFade Duration="0:0:0.12" />
        </TransitioningContentControl.PageTransition>
      </TransitioningContentControl>
    </Grid>
  </Grid>
</UserControl>
