<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ImmichDesktop.App.ViewModels"
             xmlns:c="using:ImmichDesktop.App.Controls"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="ImmichDesktop.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.Styles>
    <Style Selector="Grid.row">
      <Setter Property="MinHeight" Value="58" />
    </Style>
    <Style Selector="Grid.row > StackPanel">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Spacing" Value="2" />
      <Setter Property="Margin" Value="0,0,20,0" />
    </Style>
    <Style Selector="Grid.row TextBlock.title">
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,24,36,36" Spacing="18" MaxWidth="820" HorizontalAlignment="Stretch">
      <TextBlock Classes="h1" Text="Settings" />

      <!-- Account -->
      <Border Classes="card">
        <StackPanel Spacing="16">
          <TextBlock Classes="section" Text="ACCOUNT" />
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource AppPrimaryBrush}">
              <TextBlock Text="{Binding UserInitial}" FontSize="20" FontWeight="Medium"
                         Foreground="{DynamicResource AppOnPrimaryBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="2">
              <TextBlock Classes="h3" Text="{Binding UserName}" />
              <TextBlock Classes="caption" Text="{Binding UserEmail}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="secondary" VerticalAlignment="Center" Command="{Binding SignOutCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <mi:MaterialIcon Kind="Logout" />
                <TextBlock Text="Sign out" />
              </StackPanel>
            </Button>
          </Grid>
          <Border Classes="divider" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="title" Text="Server" />
              <TextBlock Classes="caption" Text="{Binding ServerUrl}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="0" VerticalAlignment="Center">
              <Border Classes="chip" VerticalAlignment="Center">
                <TextBlock Classes="caption" Text="{Binding ServerVersion}" />
              </Border>
              <Button Classes="ghost" Command="{Binding OpenServerCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <mi:MaterialIcon Kind="OpenInNew" />
                  <TextBlock Text="Open" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Appearance & general -->
      <Border Classes="card" Padding="22,16">
        <StackPanel>
          <TextBlock Classes="section" Text="GENERAL" Margin="0,4,0,6" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="title" Text="Theme" />
              <TextBlock Classes="caption" Text="Light, dark, or follow your Windows setting." TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1" Classes="segmented" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <RadioButton Classes="segment" GroupName="theme" IsChecked="{Binding ThemeSystem}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <mi:MaterialIcon Kind="ThemeLightDark" Width="16" Height="16" />
                    <TextBlock Text="System" />
                  </StackPanel>
                </RadioButton>
                <RadioButton Classes="segment" GroupName="theme" IsChecked="{Binding ThemeLight}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <mi:MaterialIcon Kind="WeatherSunny" Width="16" Height="16" />
                    <TextBlock Text="Light" />
                  </StackPanel>
                </RadioButton>
                <RadioButton Classes="segment" GroupName="theme" IsChecked="{Binding ThemeDark}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <mi:MaterialIcon Kind="WeatherNight" Width="16" Height="16" />
                    <TextBlock Text="Dark" />
                  </StackPanel>
                </RadioButton>
              </StackPanel>
            </Border>
          </Grid>
          <Border Classes="divider" IsVisible="{Binding AutostartSupported}" />
          <Grid Classes="row" ColumnDefinitions="*,Auto" IsVisible="{Binding AutostartSupported}">
            <StackPanel>
              <TextBlock Classes="title" Text="Start automatically" />
              <TextBlock Classes="caption" Text="{Binding AutostartDescription}" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchAtStartup}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Security -->
      <Border Classes="card" Padding="22,16">
        <StackPanel>
          <TextBlock Classes="section" Text="SECURITY" Margin="0,4,0,6" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="title" Text="App lock" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="Require Windows Hello or a password to open this window. Backup keeps running while locked." />
            </StackPanel>
            <Border Grid.Column="1" Classes="segmented" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <RadioButton Classes="segment" GroupName="lock" Content="Off" IsChecked="{Binding LockOff}" />
                <RadioButton Classes="segment" GroupName="lock" IsChecked="{Binding LockHello}" IsEnabled="{Binding HelloAvailable}"
                             ToolTip.Tip="Face, fingerprint or PIN">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <mi:MaterialIcon Kind="FaceRecognition" Width="16" Height="16" />
                    <TextBlock Text="Windows Hello" />
                  </StackPanel>
                </RadioButton>
                <RadioButton Classes="segment" GroupName="lock" IsChecked="{Binding LockPassword}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <mi:MaterialIcon Kind="FormTextboxPassword" Width="16" Height="16" />
                    <TextBlock Text="Password" />
                  </StackPanel>
                </RadioButton>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Set a password -->
          <Border Classes="banner" Margin="0,4,0,10" Padding="18,16" IsVisible="{Binding IsSettingPassword}">
            <StackPanel Spacing="10">
              <TextBlock Classes="h3" Text="Choose an app password" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="This only unlocks Immich Desktop on this PC. It's stored as a secure hash, never as plain text." />
              <Grid ColumnDefinitions="*,12,*">
                <TextBox Text="{Binding NewPassword}" PasswordChar="&#x2022;" Watermark="New password" />
                <TextBox Grid.Column="2" Text="{Binding ConfirmPassword}" PasswordChar="&#x2022;" Watermark="Confirm password">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SavePasswordCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="Turn on app lock" Command="{Binding SavePasswordCommand}" />
                <Button Classes="ghost" Content="Cancel" Command="{Binding CancelPasswordCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="banner error" Margin="0,4,0,10" IsVisible="{Binding LockError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding LockError}" TextWrapping="Wrap" />
          </Border>

          <Border Classes="divider" IsVisible="{Binding IsLockEnabled}" />
          <Grid Classes="row" ColumnDefinitions="*,Auto" IsVisible="{Binding IsLockEnabled}">
            <StackPanel>
              <TextBlock Classes="title" Text="Lock now" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="The app also locks when you close the window and after 5 minutes without activity." />
            </StackPanel>
            <Button Grid.Column="1" Classes="secondary" Command="{Binding LockNowCommand}" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <mi:MaterialIcon Kind="LockOutline" />
                <TextBlock Text="Lock" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Backup -->
      <Border Classes="card" Padding="22,16">
        <StackPanel>
          <TextBlock Classes="section" Text="BACKUP" Margin="0,4,0,6" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="title" Text="Upload speed limit" />
              <TextBlock Classes="caption" Text="Leave bandwidth for everything else on your network." TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox Grid.Column="1" ItemsSource="{Binding SpeedLimits}" SelectedItem="{Binding SelectedSpeedLimit}" VerticalAlignment="Center" />
          </Grid>
          <Border Classes="divider" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="title" Text="Simultaneous uploads" />
              <TextBlock Classes="caption" Text="More is faster on a good connection; fewer is gentler on your server." TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Concurrency}" SelectedItem="{Binding SelectedConcurrency}" VerticalAlignment="Center" />
          </Grid>
          <Border Classes="divider" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="title" Text="Pause on battery" />
              <TextBlock Classes="caption" Text="Wait until your laptop is plugged in before uploading." TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding PauseOnBattery}" />
          </Grid>
          <Border Classes="divider" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="title" Text="Full folder check" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="New files are noticed instantly. A full check also runs periodically to catch anything missed." />
            </StackPanel>
            <ComboBox Grid.Column="1" ItemsSource="{Binding RescanIntervals}" SelectedItem="{Binding SelectedRescan}" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Updates -->
      <Border Classes="card" Padding="22,16" IsVisible="{Binding UpdatesEnabled}">
        <StackPanel>
          <TextBlock Classes="section" Text="UPDATES" Margin="0,4,0,6" />
          <Grid Classes="row" ColumnDefinitions="Auto,*,Auto">
            <c:ImmichLogo Width="40" Height="40" Margin="0,0,14,0" />
            <StackPanel Grid.Column="1">
              <TextBlock Classes="title" Text="{Binding Version}" />
              <TextBlock Classes="caption" Text="{Binding UpdateStatus}" TextWrapping="Wrap" IsVisible="{Binding HasUpdateStatus}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Classes="secondary" Command="{Binding CheckForUpdatesCommand}" IsVisible="{Binding CanCheck}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <mi:MaterialIcon Kind="Refresh" Classes.spin="{Binding IsCheckingUpdates}" />
                  <TextBlock Text="Check now" />
                </StackPanel>
              </Button>
              <Button Classes="primary" Content="Restart to update" Command="{Binding InstallUpdateCommand}" IsVisible="{Binding UpdateReady}" />
              <Button Classes="primary" Content="Download" Command="{Binding OpenReleasePageCommand}" IsVisible="{Binding UpdateAvailable}" />
            </StackPanel>
          </Grid>
          <Border Classes="divider" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="title" Text="Check for updates automatically" />
              <TextBlock Classes="caption" Text="Looks for new versions on GitHub every few hours." TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding CheckForUpdates}" />
          </Grid>
          <Border Classes="divider" IsVisible="{Binding CanSelfUpdate}" />
          <Grid Classes="row" ColumnDefinitions="*,Auto" IsVisible="{Binding CanSelfUpdate}">
            <StackPanel>
              <TextBlock Classes="title" Text="Install updates automatically" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="Updates install quietly while the window is closed and nothing is uploading." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoInstallUpdates}" IsEnabled="{Binding CheckForUpdates}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Troubleshooting -->
      <Border Classes="card" Padding="22,16">
        <StackPanel>
          <TextBlock Classes="section" Text="TROUBLESHOOTING" Margin="0,4,0,6" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="title" Text="Re-check all files" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="Compare everything with your Immich library again. Nothing is uploaded twice." />
            </StackPanel>
            <Button Grid.Column="1" Classes="secondary" Content="Re-check" Command="{Binding RecheckAllCommand}" VerticalAlignment="Center" />
          </Grid>
          <Border Classes="divider" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="title" Text="Logs and app data" />
              <TextBlock Classes="caption" Text="Helpful when reporting a problem." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0" VerticalAlignment="Center">
              <Button Classes="secondary" Content="Open logs" Command="{Binding OpenLogsCommand}" />
              <Button Classes="ghost" Content="Data folder" Command="{Binding OpenDataFolderCommand}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Classes="caption tertiary" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0"
                 Text="An unofficial desktop companion for Immich. Immich and its logo belong to FUTO." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
