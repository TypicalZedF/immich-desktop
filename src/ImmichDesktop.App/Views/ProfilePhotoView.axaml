<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ImmichDesktop.App.Services"
             xmlns:vm="using:ImmichDesktop.App.ViewModels"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="ImmichDesktop.App.Views.ProfilePhotoView"
             x:DataType="vm:ProfilePhotoViewModel">
  <!-- Choose a profile picture from Immich (or this PC), then crop it in a circle like the Immich web app. -->
  <Border Background="{DynamicResource AppPageBrush}" BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1"
          CornerRadius="22" Margin="40,32" MaxWidth="980" MaxHeight="780" ClipToBounds="True"
          BoxShadow="0 18 50 0 #40000000">
    <DockPanel>
      <!-- Header -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="20,18,18,14">
        <Button Classes="ghost icon" VerticalAlignment="Center" Margin="0,0,8,0" Command="{Binding BackCommand}"
                IsVisible="{Binding !IsPicking}" IsEnabled="{Binding !IsSaving}" l:Tr.Tip="Back to your photos">
          <mi:MaterialIcon Kind="ArrowLeft" Width="20" Height="20" />
        </Button>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="8,0,0,0">
          <TextBlock Classes="h2" Text="{Binding Title}" />
          <TextBlock Classes="secondary" Text="{Binding Subtitle}" />
        </StackPanel>
        <Button Grid.Column="2" Classes="secondary" VerticalAlignment="Center" Margin="0,0,8,0"
                Command="{Binding UploadFromComputerCommand}" IsVisible="{Binding IsPicking}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="Upload" />
            <TextBlock l:Tr.Text="Upload from this PC" />
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Classes="ghost icon" VerticalAlignment="Center" Command="{Binding CloseCommand}"
                IsEnabled="{Binding !IsSaving}" l:Tr.Tip="Close (Esc)">
          <mi:MaterialIcon Kind="Close" Width="20" Height="20" />
        </Button>
      </Grid>

      <!-- Error -->
      <Border DockPanel.Dock="Top" Classes="banner error" Margin="24,0,24,10"
              IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <mi:MaterialIcon Kind="AlertCircleOutline" />
          <TextBlock Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- Footer (cropping) -->
      <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,1,0,0"
              Padding="20,14" IsVisible="{Binding !IsPicking}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
          <Button Classes="secondary" l:Tr.Content="Cancel" Command="{Binding CloseCommand}" IsEnabled="{Binding !IsSaving}" />
          <Button Classes="primary" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsSaving}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="Loading" Classes="spin" Width="16" Height="16" IsVisible="{Binding IsSaving}" />
              <TextBlock l:Tr.Text="Set as profile picture" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <Panel>
        <!-- Step 1: your Immich library -->
        <ContentControl Content="{Binding Library}" IsVisible="{Binding IsPicking}" />

        <!-- Step 2: crop -->
        <Panel IsVisible="{Binding !IsPicking}" IsEnabled="{Binding !IsSaving}">
        <StackPanel Spacing="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                    DataContext="{Binding Cropper}" x:DataType="vm:PhotoCropViewModel">
          <Panel Name="CropArea" Width="{Binding Viewport}" Height="{Binding Viewport}" ClipToBounds="True"
                 Background="{DynamicResource AppNeutralSoftBrush}" Cursor="SizeAll">
            <Canvas>
              <Image Source="{Binding Image}" Stretch="Fill" RenderOptions.BitmapInterpolationMode="HighQuality"
                     Width="{Binding ImageWidth}" Height="{Binding ImageHeight}"
                     Canvas.Left="{Binding ImageLeft}" Canvas.Top="{Binding ImageTop}" />
            </Canvas>
            <!-- Dim everything outside the circle (340 = PhotoCropViewModel.ViewportSize) -->
            <Path Fill="#99000000" IsHitTestVisible="False">
              <Path.Data>
                <GeometryGroup FillRule="EvenOdd">
                  <RectangleGeometry Rect="0,0,340,340" />
                  <EllipseGeometry Rect="0,0,340,340" />
                </GeometryGroup>
              </Path.Data>
            </Path>
            <Ellipse Stroke="#E6FFFFFF" StrokeThickness="2" IsHitTestVisible="False" />
          </Panel>

          <!-- Zoom and rotate -->
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" Width="{Binding Viewport}">
            <Button Classes="ghost icon" Command="{Binding ZoomOutCommand}" l:Tr.Tip="Zoom out">
              <mi:MaterialIcon Kind="MagnifyMinusOutline" Width="20" Height="20" />
            </Button>
            <Slider Grid.Column="1" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Zoom}"
                    VerticalAlignment="Center" Margin="6,0" />
            <Button Grid.Column="2" Classes="ghost icon" Command="{Binding ZoomInCommand}" l:Tr.Tip="Zoom in">
              <mi:MaterialIcon Kind="MagnifyPlusOutline" Width="20" Height="20" />
            </Button>
            <Button Grid.Column="3" Classes="ghost icon" Margin="6,0,0,0" Command="{Binding RotateCommand}" l:Tr.Tip="Rotate">
              <mi:MaterialIcon Kind="RotateRight" Width="20" Height="20" />
            </Button>
          </Grid>
          <Button Classes="link" HorizontalAlignment="Center" l:Tr.Content="Reset" Command="{Binding ResetCommand}" />
        </StackPanel>
        </Panel>

        <!-- Loading the chosen photo -->
        <Panel IsVisible="{Binding IsBusy}" Background="{DynamicResource AppOverlayBrush}">
          <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,16">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <mi:MaterialIcon Kind="Loading" Classes="spin" Width="22" Height="22" Foreground="{DynamicResource AppPrimaryBrush}" />
              <TextBlock l:Tr.Text="Opening photo…" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </Panel>
      </Panel>
    </DockPanel>
  </Border>
</UserControl>
