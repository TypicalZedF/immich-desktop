<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ImmichDesktop.App.ViewModels"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="ImmichDesktop.App.Views.FoldersView"
             x:DataType="vm:FoldersViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="36,30,36,36" Spacing="18" MaxWidth="1000">

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Classes="h1" Text="Folders" />
          <TextBlock Classes="secondary" TextWrapping="Wrap"
                     Text="Choose which folders on this computer are backed up to Immich." />
        </StackPanel>
        <Button Grid.Column="1" Classes="primary" VerticalAlignment="Center" Command="{Binding AddFolderCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="FolderPlusOutline" />
            <TextBlock Text="Add folder" />
          </StackPanel>
        </Button>
      </Grid>

      <Border Classes="banner error" IsVisible="{Binding AddError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <mi:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18" />
          <TextBlock Text="{Binding AddError}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Empty state -->
      <Border Classes="card" Padding="40" IsVisible="{Binding IsEmpty}">
        <StackPanel Spacing="12" HorizontalAlignment="Center">
          <Border Classes="iconChip" Width="64" Height="64" CornerRadius="20" HorizontalAlignment="Center">
            <mi:MaterialIcon Kind="FolderImage" Width="32" Height="32" />
          </Border>
          <TextBlock Classes="h2" Text="No folders yet" HorizontalAlignment="Center" />
          <TextBlock Classes="secondary" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380"
                     Text="Add a folder with photos or videos and Immich Desktop will keep it backed up automatically." />
          <Button Classes="primary" HorizontalAlignment="Center" Margin="0,6,0,0" Command="{Binding AddFolderCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="FolderPlusOutline" />
              <TextBlock Text="Add folder" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Folders}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Spacing="14" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FolderItemViewModel">
            <Border Classes="card" Padding="0">
              <StackPanel>
                <!-- Summary row -->
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="22,18">
                  <Border Classes="iconChip" Width="46" Height="46" CornerRadius="14"
                          Opacity="{Binding Enabled, Converter={x:Static vm:Converters.EnabledOpacity}}">
                    <mi:MaterialIcon Kind="Folder" Width="24" Height="24" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="14,0,16,0" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Classes="h3" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="caption tertiary" Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                      <ProgressBar Classes="thin" Classes.success="{Binding IsComplete}" Width="140" VerticalAlignment="Center"
                                   Value="{Binding Percent}" Maximum="100" />
                      <TextBlock Classes="caption" Text="{Binding StatsText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="caption" Foreground="{DynamicResource AppWarningBrush}" Text="{Binding IssueText}"
                               IsVisible="{Binding IssueText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="2" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                ToolTip.Tip="Back up this folder" />
                  <Button Grid.Column="3" Classes="ghost icon" Margin="8,0,0,0" VerticalAlignment="Center"
                          Command="{Binding ToggleExpandedCommand}" ToolTip.Tip="Folder options">
                    <mi:MaterialIcon Kind="{Binding ExpandIcon}" Width="20" Height="20" />
                  </Button>
                </Grid>

                <!-- Options -->
                <Border IsVisible="{Binding IsExpanded}" BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,1,0,0" Padding="22,18,22,20">
                  <Grid ColumnDefinitions="*,28,*" RowDefinitions="Auto,Auto,Auto">
                    <StackPanel Spacing="10">
                      <TextBlock Classes="section" Text="WHAT TO BACK UP" />
                      <CheckBox IsChecked="{Binding IncludePhotos}" Content="Photos" />
                      <CheckBox IsChecked="{Binding IncludeVideos}" Content="Videos" />
                      <CheckBox IsChecked="{Binding IncludeSubfolders}" Content="Include subfolders" />
                      <CheckBox IsChecked="{Binding SkipScreenshots}" Content="Skip screenshots" ToolTip.Tip="Skips the Screenshots folder and files named Screenshot…" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="8">
                      <TextBlock Classes="section" Text="ADD TO ALBUM" />
                      <TextBox Text="{Binding AlbumName}" Watermark="Don't add to an album" />
                      <TextBlock Classes="caption tertiary" TextWrapping="Wrap"
                                 Text="New uploads from this folder are added to this album. It's created if it doesn't exist." />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="8" Margin="0,20,0,0">
                      <TextBlock Classes="section" Text="SKIP FILES AND FOLDERS" />
                      <TextBox Classes="multiline" Text="{Binding ExcludePatterns}"
                               Watermark="One per line, for example:&#x0a;Screenshots&#x0a;*.png&#x0a;Trips/2019/**" />
                      <TextBlock Classes="caption tertiary" TextWrapping="Wrap"
                                 Text="Names match at any depth. Use * as a wildcard and ** for any number of folders." />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="10" Margin="0,20,0,0">
                      <Button Classes="secondary" Command="{Binding OpenFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <mi:MaterialIcon Kind="FolderOpenOutline" />
                          <TextBlock Text="Open folder" />
                        </StackPanel>
                      </Button>
                      <Button Classes="danger" Command="{Binding RemoveCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <mi:MaterialIcon Kind="DeleteOutline" />
                          <TextBlock Text="Remove folder" />
                        </StackPanel>
                      </Button>
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="6,0,0,0"
                                  IsVisible="{Binding SaveHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <mi:MaterialIcon Kind="CheckCircleOutline" Width="16" Height="16" Foreground="{DynamicResource AppSuccessBrush}" />
                        <TextBlock Classes="caption" Text="{Binding SaveHint}" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Classes="caption tertiary" TextWrapping="Wrap" Margin="4,4,0,0"
                 Text="Changes apply right away: files you exclude stop uploading immediately. Backup only adds to Immich: excluding or deleting files here never removes anything already on your server." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
