<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ImmichDesktop.App.Services"
             xmlns:vm="using:ImmichDesktop.App.ViewModels"
             xmlns:c="using:ImmichDesktop.App.Controls"
             xmlns:api="using:ImmichDesktop.Core.Api"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="ImmichDesktop.App.Views.PhotosView"
             x:DataType="vm:PhotosViewModel">
  <UserControl.Styles>
    <!-- The grid is a plain virtualized list: no selection or hover chrome on rows -->
    <Style Selector="ListBox.grid">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.grid ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox.grid ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.grid ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.grid ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.grid ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Tiles -->
    <Style Selector="Button.tile">
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{DynamicResource AppNeutralSoftBrush}" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.playVideo">
      <Setter Property="Background" Value="#88000000" />
      <Setter Property="CornerRadius" Value="40" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.playVideo:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#CC000000" />
    </Style>
    <Style Selector="Button.playVideo:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#88000000" />
    </Style>
    <Style Selector="Button.videoControl">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="7" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.videoControl mi|MaterialIcon">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.videoControl:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Slider.videoSeek">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.utility">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.utility:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppNeutralSoftBrush}" />
    </Style>
    <Style Selector="mi|MaterialIcon.utilityIcon">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
    </Style>
    <Style Selector="Button.dupe.trashed Image">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Border.syncBadge">
      <Setter Property="Background" Value="#66000000" />
    </Style>
    <Style Selector="Border.syncBadge.warn">
      <Setter Property="Background" Value="#E0B45309" />
    </Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppNeutralSoftBrush}" />
    </Style>
    <Style Selector="Button.tile:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Button.tile:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppNeutralSoftBrush}" />
    </Style>
    <Style Selector="Button.tile Border.shade">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.tile:pointerover Border.shade">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.tile Image.thumb">
      <Setter Property="Transitions">
        <Transitions><ThicknessTransition Property="Margin" Duration="0:0:0.12" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.tile.selected Image.thumb">
      <Setter Property="Margin" Value="12" />
    </Style>
    <Style Selector="Button.tile.selected">
      <Setter Property="Background" Value="{DynamicResource AppPrimarySoftBrush}" />
    </Style>
    <Style Selector="Button.check">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="6" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Button.tile:pointerover Button.check, Button.check.visible">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.check:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.check.on mi|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
    </Style>

    <!-- Tabs -->
    <Style Selector="RadioButton.tab">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Bg" Background="Transparent" CornerRadius="999" Padding="{TemplateBinding Padding}"
                  BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1">
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="RadioButton.tab:pointerover /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    </Style>
    <Style Selector="RadioButton.tab:checked /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource AppPrimarySoftBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="RadioButton.tab:checked">
      <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
    </Style>

    <!-- Cover cards (albums, people, places) -->
    <Style Selector="Button.cover">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,18,22" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Button.cover:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.cover:pointerover Border.coverImage">
      <Setter Property="Opacity" Value="0.88" />
    </Style>

    <!-- Viewer -->
    <Style Selector="Button.viewerNav">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="22" />
      <Setter Property="Background" Value="#66000000" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.viewerNav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#99000000" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.viewerNav mi|MaterialIcon">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
    </Style>
    <Style Selector="TextBlock.infoLabel">
      <Setter Property="Foreground" Value="#B3FFFFFF" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.infoValue">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Selection bar -->
    <Style Selector="Button.barAction">
      <Setter Property="Padding" Value="10,6" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <DockPanel>
      <!-- Header: back, title, search, actions -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="28,20,28,10" IsVisible="{Binding !IsSelecting}">
        <Button Classes="ghost icon" VerticalAlignment="Center" Margin="0,0,8,0" Command="{Binding BackCommand}"
                IsVisible="{Binding IsDrilledIn}" l:Tr.Tip="Back">
          <mi:MaterialIcon Kind="ArrowLeft" Width="22" Height="22" />
        </Button>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="4,0,16,0" IsVisible="{Binding ShowHeading}">
          <TextBlock Classes="h1" Text="{Binding Heading}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="secondary" Text="{Binding Summary}" IsVisible="{Binding ShowGrid}" />
        </StackPanel>
        <TextBox Grid.Column="2" Name="SearchBox" Width="280" VerticalAlignment="Center" Text="{Binding SearchText}"
                 l:Tr.Watermark="Search your photos" IsVisible="{Binding IsPicker}">
          <TextBox.InnerLeftContent>
            <mi:MaterialIcon Kind="Magnify" Width="18" Height="18" Margin="10,0,0,0" Foreground="{DynamicResource AppTextTertiaryBrush}" />
          </TextBox.InnerLeftContent>
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" VerticalAlignment="Center">
          <Button Classes="secondary" Command="{Binding RestoreAllCommand}" IsVisible="{Binding ShowTrashActions}">
            <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Restore" /><TextBlock l:Tr.Text="Restore all" /></StackPanel>
          </Button>
          <Button Classes="secondary danger" Command="{Binding EmptyTrashCommand}" IsVisible="{Binding ShowTrashActions}">
            <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="DeleteForeverOutline" /><TextBlock l:Tr.Text="Empty trash" /></StackPanel>
          </Button>
          <Button Classes="secondary" Command="{Binding LockCommand}" IsVisible="{Binding ShowLockAction}">
            <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="LockOutline" /><TextBlock l:Tr.Text="Lock" /></StackPanel>
          </Button>
          <Button Classes="ghost icon" Command="{Binding ShareAlbumCommand}" IsVisible="{Binding CanShareAlbum}" l:Tr.Tip="Share album">
            <mi:MaterialIcon Kind="ShareVariantOutline" Width="20" Height="20" />
          </Button>
          <Button Classes="ghost icon" Command="{Binding DeleteOpenAlbumCommand}" IsVisible="{Binding CanDeleteAlbum}" l:Tr.Tip="Delete album">
            <mi:MaterialIcon Kind="TrashCanOutline" Width="20" Height="20" />
          </Button>
          <Button Classes="ghost icon" Command="{Binding RefreshCommand}" l:Tr.Tip="Refresh">
            <mi:MaterialIcon Kind="Refresh" Width="20" Height="20" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- Selection bar: replaces the header while photos are selected -->
      <Border DockPanel.Dock="Top" Margin="20,16,20,10" Padding="8,6" CornerRadius="14" Background="{DynamicResource AppPrimarySoftBrush}"
              IsVisible="{Binding IsSelecting}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="ghost icon" Command="{Binding ClearSelectionCommand}" l:Tr.Tip="Clear selection (Esc)">
              <mi:MaterialIcon Kind="Close" Width="20" Height="20" />
            </Button>
            <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
            <Button Classes="ghost barAction" Command="{Binding RestoreSelectionCommand}" IsVisible="{Binding CanRestore}">
              <StackPanel Orientation="Horizontal" Spacing="6"><mi:MaterialIcon Kind="Restore" /><TextBlock l:Tr.Text="Restore" /></StackPanel>
            </Button>
            <Button Classes="ghost barAction" Command="{Binding DeleteSelectionForeverCommand}" IsVisible="{Binding CanRestore}">
              <StackPanel Orientation="Horizontal" Spacing="6"><mi:MaterialIcon Kind="DeleteForeverOutline" /><TextBlock l:Tr.Text="Delete forever" /></StackPanel>
            </Button>
            <Button Classes="ghost barAction" Command="{Binding MoveSelectionOutOfLockedCommand}" IsVisible="{Binding CanMoveOutOfLocked}">
              <StackPanel Orientation="Horizontal" Spacing="6"><mi:MaterialIcon Kind="LockOpenVariantOutline" /><TextBlock l:Tr.Text="Move out of locked folder" /></StackPanel>
            </Button>
            <Button Classes="ghost barAction" Command="{Binding ShareSelectionCommand}" IsVisible="{Binding CanUseNormalActions}" l:Tr.Tip="Share">
              <StackPanel Orientation="Horizontal" Spacing="6"><mi:MaterialIcon Kind="ShareVariantOutline" /><TextBlock l:Tr.Text="Share" /></StackPanel>
            </Button>
            <Button Classes="ghost barAction" Command="{Binding AddSelectionToAlbumCommand}" IsVisible="{Binding CanUseNormalActions}" l:Tr.Tip="Add to album">
              <StackPanel Orientation="Horizontal" Spacing="6"><mi:MaterialIcon Kind="ImagePlusOutline" /><TextBlock l:Tr.Text="Add to album" /></StackPanel>
            </Button>
            <Button Classes="ghost icon" Command="{Binding FavoriteSelectionCommand}" IsVisible="{Binding CanUseNormalActions}" l:Tr.Tip="Favorite">
              <mi:MaterialIcon Kind="HeartOutline" Width="20" Height="20" />
            </Button>
            <Button Classes="ghost icon" Command="{Binding DownloadSelectionCommand}" IsVisible="{Binding !CanRestore}" l:Tr.Tip="Download">
              <mi:MaterialIcon Kind="TrayArrowDown" Width="20" Height="20" />
            </Button>
            <Button Classes="ghost icon" Command="{Binding ArchiveSelectionCommand}" IsVisible="{Binding CanArchive}" l:Tr.Tip="Archive">
              <mi:MaterialIcon Kind="ArchiveArrowDownOutline" Width="20" Height="20" />
            </Button>
            <Button Classes="ghost icon" Command="{Binding UnarchiveSelectionCommand}" IsVisible="{Binding CanUnarchive}" l:Tr.Tip="Unarchive">
              <mi:MaterialIcon Kind="ArchiveArrowUpOutline" Width="20" Height="20" />
            </Button>
            <Button Classes="ghost icon" Command="{Binding MoveSelectionToLockedCommand}" IsVisible="{Binding CanMoveToLocked}" l:Tr.Tip="Move to locked folder">
              <mi:MaterialIcon Kind="LockOutline" Width="20" Height="20" />
            </Button>
            <Button Classes="ghost icon" Command="{Binding TrashSelectionCommand}" IsVisible="{Binding CanUseNormalActions}" l:Tr.Tip="Move to trash">
              <mi:MaterialIcon Kind="TrashCanOutline" Width="20" Height="20" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Panel>
        <!-- Photo grid with the date rail -->
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowGrid}">
          <ListBox Name="Grid" Classes="grid" ItemsSource="{Binding Rows}" Margin="28,0,0,0" Padding="0,0,12,24"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.DataTemplates>
              <DataTemplate DataType="vm:MonthHeaderViewModel">
                <StackPanel Orientation="Horizontal" Spacing="10" Height="54" VerticalAlignment="Bottom" Margin="2,0,0,0">
                  <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Medium" VerticalAlignment="Bottom" Margin="0,0,0,12" />
                  <TextBlock Classes="caption tertiary" Text="{Binding Count}" VerticalAlignment="Bottom" Margin="0,0,0,14" />
                </StackPanel>
              </DataTemplate>
              <DataTemplate DataType="vm:AssetRowViewModel">
                <ItemsControl ItemsSource="{Binding Cells}" Height="{Binding RowHeight}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AssetCellViewModel">
                      <Button Classes="tile" Classes.selected="{Binding IsSelected}" Width="{Binding TileSize}" Height="{Binding TileSize}" VerticalAlignment="Top"
                              Command="{Binding OpenCommand}" IsVisible="{Binding !IsMissing}" IsEnabled="{Binding CanOpen}">
                        <Panel>
                          <Image Classes="thumb" Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                          <!-- A file on this PC we can't preview here (video, HEIC…) -->
                          <StackPanel IsVisible="{Binding ShowLocalPlaceholder}" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsHitTestVisible="False">
                            <mi:MaterialIcon Kind="{Binding IsVideo, Converter={x:Static vm:Converters.LocalFileIcon}}" Width="30" Height="30"
                                             Foreground="{DynamicResource AppTextTertiaryBrush}" />
                          </StackPanel>
                          <!-- Hover shade so the check stays visible on bright photos -->
                          <Border Classes="shade" IsHitTestVisible="False" Height="56" VerticalAlignment="Top">
                            <Border.Background>
                              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Color="#66000000" Offset="0" />
                                <GradientStop Color="#00000000" Offset="1" />
                              </LinearGradientBrush>
                            </Border.Background>
                          </Border>
                          <!-- Video badge -->
                          <Border IsVisible="{Binding IsVideo}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Margin="6" Padding="6,2" CornerRadius="6" Background="#99000000">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <TextBlock Text="{Binding DurationText}" Foreground="White" FontSize="11.5" FontWeight="Medium" />
                              <mi:MaterialIcon Kind="PlayCircleOutline" Width="14" Height="14" Foreground="White" />
                            </StackPanel>
                          </Border>
                          <mi:MaterialIcon IsVisible="{Binding IsFavorite}" Kind="Heart" Width="16" Height="16" Foreground="White"
                                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" />
                          <!-- File size (Large files) -->
                          <Border IsVisible="{Binding HasSizeText}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5"
                                  Padding="6,2" CornerRadius="6" Background="#99000000">
                            <TextBlock Text="{Binding SizeText}" Foreground="White" FontSize="11.5" FontWeight="Medium" />
                          </Border>
                          <!-- In Immich, on this PC, or both -->
                          <Border Classes="syncBadge" Classes.warn="{Binding SyncFailed}" IsVisible="{Binding HasSyncIcon}"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5"
                                  Padding="3" CornerRadius="8" ToolTip.Tip="{Binding SyncText}">
                            <mi:MaterialIcon Kind="{Binding SyncIcon}" Width="15" Height="15" Foreground="White" />
                          </Border>
                          <!-- Select -->
                          <Button Classes="check" Classes.visible="{Binding IsSelected}" Classes.on="{Binding IsSelected}"
                                  Command="{Binding ToggleSelectCommand}" IsVisible="{Binding CanSelect}" l:Tr.Tip="Select">
                            <Panel>
                              <Ellipse Width="22" Height="22" Fill="White" IsVisible="{Binding IsSelected}" />
                              <mi:MaterialIcon Kind="CheckCircle" Width="26" Height="26" IsVisible="{Binding IsSelected}" />
                              <mi:MaterialIcon Kind="CheckboxBlankCircleOutline" Width="24" Height="24" IsVisible="{Binding !IsSelected}" />
                            </Panel>
                          </Button>
                        </Panel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>
            </ListBox.DataTemplates>
          </ListBox>
          <c:TimelineScrubber Grid.Column="1" Name="Scrubber" Width="56" Sections="{Binding Sections}"
                              IsVisible="{Binding HasSections}" Margin="0,0,4,8" />

          <!-- States -->
          <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoading}">
            <mi:MaterialIcon Kind="Loading" Classes="spin" Width="28" Height="28" Foreground="{DynamicResource AppPrimaryBrush}" />
            <TextBlock Classes="secondary" l:Tr.Text="Loading…" />
          </StackPanel>
          <Border Classes="card" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <StackPanel Spacing="12">
              <mi:MaterialIcon Kind="CloudOffOutline" Width="32" Height="32" Foreground="{DynamicResource AppTextTertiaryBrush}" />
              <TextBlock Text="{Binding Error}" TextWrapping="Wrap" TextAlignment="Center" />
              <Button Classes="primary" HorizontalAlignment="Center" l:Tr.Content="Try again" Command="{Binding RefreshCommand}" />
            </StackPanel>
          </Border>
          <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsEmpty}" MaxWidth="420">
            <mi:MaterialIcon Kind="ImageMultipleOutline" Width="40" Height="40" Foreground="{DynamicResource AppTextTertiaryBrush}" />
            <TextBlock Classes="secondary" Text="{Binding EmptyText}" TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>
        </Grid>

        <!-- Albums -->
        <ScrollViewer IsVisible="{Binding ShowAlbums}" HorizontalScrollBarVisibility="Disabled" Padding="28,8,10,24">
          <ItemsControl ItemsSource="{Binding Albums}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AlbumCardViewModel">
                <Button Classes="cover" Width="196" Command="{Binding OpenCommand}">
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem l:Tr.Header="Open" Command="{Binding OpenCommand}" />
                      <MenuItem l:Tr.Header="Delete album" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" />
                    </ContextMenu>
                  </Button.ContextMenu>
                  <StackPanel Spacing="8">
                    <Border Classes="coverImage" Width="196" Height="196" CornerRadius="16" ClipToBounds="True" Background="{DynamicResource AppNeutralSoftBrush}">
                      <Panel>
                        <mi:MaterialIcon Kind="ImageAlbum" Width="40" Height="40" Foreground="{DynamicResource AppTextTertiaryBrush}" />
                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                      </Panel>
                    </Border>
                    <StackPanel Spacing="1" Margin="2,0">
                      <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="caption" Text="{Binding Subtitle}" />
                    </StackPanel>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- Explore: people and places -->
        <ScrollViewer IsVisible="{Binding ShowExplore}" HorizontalScrollBarVisibility="Disabled" Padding="28,4,10,24">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="h3" l:Tr.Text="People" />
              <Button Grid.Column="1" Classes="link" l:Tr.Content="Show all" Command="{Binding ShowAllPeopleCommand}" IsVisible="{Binding HasMorePeople}" />
            </Grid>
            <TextBlock Classes="secondary" Text="{Binding PeopleMessage}" TextWrapping="Wrap"
                       IsVisible="{Binding PeopleMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ItemsControl ItemsSource="{Binding People}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PersonCardViewModel">
                  <Button Classes="cover" Width="120" Command="{Binding OpenCommand}">
                    <StackPanel Spacing="8">
                      <Border Classes="coverImage" Width="120" Height="120" CornerRadius="60" ClipToBounds="True" Background="{DynamicResource AppNeutralSoftBrush}">
                        <Panel>
                          <mi:MaterialIcon Kind="AccountOutline" Width="40" Height="40" Foreground="{DynamicResource AppTextTertiaryBrush}" />
                          <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                        </Panel>
                      </Border>
                      <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                                 Classes.tertiary="{Binding !IsNamed}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
              <TextBlock Classes="h3" l:Tr.Text="Places" />
              <Button Grid.Column="1" Classes="link" l:Tr.Content="Show all" Command="{Binding ShowAllPlacesCommand}" IsVisible="{Binding HasMorePlaces}" />
            </Grid>
            <TextBlock Classes="secondary" Text="{Binding PlacesMessage}" TextWrapping="Wrap"
                       IsVisible="{Binding PlacesMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ItemsControl ItemsSource="{Binding Places}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlaceCardViewModel">
                  <Button Classes="cover" Width="176" Command="{Binding OpenCommand}">
                    <Border Classes="coverImage" Width="176" Height="176" CornerRadius="16" ClipToBounds="True" Background="{DynamicResource AppNeutralSoftBrush}">
                      <Panel>
                        <mi:MaterialIcon Kind="MapMarkerOutline" Width="40" Height="40" Foreground="{DynamicResource AppTextTertiaryBrush}" />
                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                        <Border VerticalAlignment="Bottom" Padding="12,28,12,10">
                          <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                              <GradientStop Color="#00000000" Offset="0" />
                              <GradientStop Color="#B3000000" Offset="1" />
                            </LinearGradientBrush>
                          </Border.Background>
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" Foreground="#D9FFFFFF" FontSize="12" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Border>
                      </Panel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- Sharing: shared albums, your links, partners -->
        <ScrollViewer IsVisible="{Binding ShowSharing}" HorizontalScrollBarVisibility="Disabled" Padding="28,4,10,24">
          <StackPanel Spacing="10">
            <StackPanel Spacing="10" IsVisible="{Binding HasPartners}">
              <TextBlock Classes="h3" l:Tr.Text="Partners" />
              <TextBlock Classes="secondary" l:Tr.Text="People who share their photos with you." />
              <ItemsControl ItemsSource="{Binding Partners}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PartnerViewModel">
                    <Button Classes="secondary" Margin="0,0,10,10" Padding="10,8,16,8" Command="{Binding OpenCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AppPrimarySoftBrush}">
                          <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Partner.Name}" FontWeight="Medium" />
                          <TextBlock Classes="caption" Text="{Binding Partner.Email}" />
                        </StackPanel>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <TextBlock Classes="h3" l:Tr.Text="Shared albums" />
            <TextBlock Classes="secondary" Text="{Binding SharedAlbumsMessage}" TextWrapping="Wrap"
                       IsVisible="{Binding SharedAlbumsMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ItemsControl ItemsSource="{Binding SharedAlbums}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AlbumCardViewModel">
                  <Button Classes="cover" Width="176" Command="{Binding OpenCommand}">
                    <StackPanel Spacing="8">
                      <Border Classes="coverImage" Width="176" Height="176" CornerRadius="16" ClipToBounds="True" Background="{DynamicResource AppNeutralSoftBrush}">
                        <Panel>
                          <mi:MaterialIcon Kind="ImageAlbum" Width="40" Height="40" Foreground="{DynamicResource AppTextTertiaryBrush}" />
                          <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                        </Panel>
                      </Border>
                      <StackPanel Spacing="1" Margin="2,0">
                        <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="caption" Text="{Binding Subtitle}" />
                      </StackPanel>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="h3" l:Tr.Text="Shared links" Margin="0,12,0,0" />
            <TextBlock Classes="secondary" Text="{Binding SharedLinksMessage}" TextWrapping="Wrap"
                       IsVisible="{Binding SharedLinksMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ItemsControl ItemsSource="{Binding SharedLinks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SharedLinkViewModel">
                  <Border Classes="card" Padding="10" Margin="0,0,0,8" CornerRadius="14">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Width="56" Height="56" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource AppNeutralSoftBrush}">
                        <Panel>
                          <mi:MaterialIcon Kind="LinkVariant" Width="22" Height="22" Foreground="{DynamicResource AppTextTertiaryBrush}" />
                          <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="caption" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis"
                                   Classes.tertiary="{Binding IsExpired}" />
                        <TextBlock Classes="caption tertiary" Text="{Binding Url}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Classes="ghost icon" Command="{Binding CopyCommand}" l:Tr.Tip="Copy link">
                          <mi:MaterialIcon Kind="ContentCopy" Width="18" Height="18" />
                        </Button>
                        <Button Classes="ghost icon" Command="{Binding OpenCommand}" l:Tr.Tip="Open">
                          <mi:MaterialIcon Kind="OpenInNew" Width="18" Height="18" />
                        </Button>
                        <Button Classes="ghost icon" Command="{Binding DeleteCommand}" l:Tr.Tip="Delete link">
                          <mi:MaterialIcon Kind="TrashCanOutline" Width="18" Height="18" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- Utilities, laid out like the Immich web app's -->
        <ScrollViewer IsVisible="{Binding ShowUtilities}" HorizontalScrollBarVisibility="Disabled" Padding="28,4,10,24">
          <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <Border Classes="card" Padding="8,14,8,8" CornerRadius="20">
              <StackPanel Spacing="2">
                <TextBlock Classes="caption" l:Tr.Text="Organize your library" Margin="14,0,0,6" />
                <Button Classes="utility" Command="{Binding OpenDuplicatesCommand}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <mi:MaterialIcon Kind="ContentDuplicate" Classes="utilityIcon" />
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                      <TextBlock l:Tr.Text="Review duplicates" FontWeight="Medium" />
                      <TextBlock Classes="caption" Text="{Binding DuplicatesText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" Foreground="{DynamicResource AppTextTertiaryBrush}" />
                  </Grid>
                </Button>
                <Button Classes="utility" Command="{Binding OpenLargeFilesCommand}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <mi:MaterialIcon Kind="ImageSizeSelectLarge" Classes="utilityIcon" />
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                      <TextBlock l:Tr.Text="Review large files" FontWeight="Medium" />
                      <TextBlock Classes="caption" l:Tr.Text="Your biggest photos and videos, to free up space." TextWrapping="Wrap" />
                    </StackPanel>
                    <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" Foreground="{DynamicResource AppTextTertiaryBrush}" />
                  </Grid>
                </Button>
              </StackPanel>
            </Border>
            <Border Classes="card" Padding="8,14,8,8" CornerRadius="20">
              <StackPanel Spacing="2">
                <TextBlock Classes="caption" l:Tr.Text="This PC" Margin="14,0,0,6" />
                <Button Classes="utility" Command="{Binding OpenNotBackedUpCommand}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <mi:MaterialIcon Kind="CloudUploadOutline" Classes="utilityIcon" />
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                      <TextBlock l:Tr.Text="Not backed up yet" FontWeight="Medium" />
                      <TextBlock Classes="caption" Text="{Binding NotBackedUpText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" Foreground="{DynamicResource AppTextTertiaryBrush}" />
                  </Grid>
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Review duplicates -->
        <Panel IsVisible="{Binding ShowDuplicates}">
          <ContentControl Content="{Binding Duplicates}">
            <ContentControl.DataTemplates>
              <DataTemplate DataType="vm:DuplicatesViewModel">
                <Panel>
                  <DockPanel IsVisible="{Binding HasGroups}">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="28,0,24,12">
                      <TextBlock Classes="secondary" Text="{Binding Summary}" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="secondary" Command="{Binding KeepAllSuggestedCommand}" IsEnabled="{Binding !IsBusy}"
                              l:Tr.Tip="Keeps the suggested photo of every group; the others go to the trash">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <mi:MaterialIcon Kind="AutoFix" Width="16" Height="16" />
                          <TextBlock l:Tr.Text="Keep the best of each" />
                        </StackPanel>
                      </Button>
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="28,0,12,24">
                      <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:DuplicateGroupViewModel">
                            <Border Classes="card" Padding="16" Margin="0,0,0,14" CornerRadius="18">
                              <StackPanel Spacing="12">
                                <ItemsControl ItemsSource="{Binding Items}">
                                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DuplicateItemViewModel">
                                      <StackPanel Width="190" Margin="0,0,12,4" Spacing="6">
                                        <Button Classes="tile dupe" Classes.trashed="{Binding IsTrashed}" Width="190" Height="190" Command="{Binding ToggleKeepCommand}"
                                                l:Tr.Tip="Click to keep or trash">
                                          <Panel>
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,3" CornerRadius="8"
                                                    Background="{DynamicResource AppPrimaryBrush}" IsVisible="{Binding IsKept}">
                                              <StackPanel Orientation="Horizontal" Spacing="4">
                                                <mi:MaterialIcon Kind="Check" Width="14" Height="14" Foreground="White" />
                                                <TextBlock l:Tr.Text="Keep" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                              </StackPanel>
                                            </Border>
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,3" CornerRadius="8"
                                                    Background="#D0B42318" IsVisible="{Binding IsTrashed}">
                                              <StackPanel Orientation="Horizontal" Spacing="4">
                                                <mi:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14" Foreground="White" />
                                                <TextBlock l:Tr.Text="Trash" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                              </StackPanel>
                                            </Border>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Padding="6,2" CornerRadius="6"
                                                    Background="#99000000" IsVisible="{Binding IsSuggested}">
                                              <TextBlock l:Tr.Text="Suggested" Foreground="White" FontSize="11" />
                                            </Border>
                                            <Button Classes="ghost icon" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                                    Command="{Binding OpenCommand}" l:Tr.Tip="View" Background="#66000000">
                                              <mi:MaterialIcon Kind="ArrowExpand" Width="16" Height="16" Foreground="White" />
                                            </Button>
                                          </Panel>
                                        </Button>
                                        <StackPanel Spacing="1" Margin="2,0">
                                          <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                          <TextBlock Classes="caption" Text="{Binding Details}" />
                                          <TextBlock Classes="caption tertiary" Text="{Binding DateText}" />
                                        </StackPanel>
                                      </StackPanel>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                  <Button Classes="ghost" l:Tr.Content="Not duplicates" Command="{Binding NotDuplicatesCommand}" />
                                  <Button Classes="primary" Content="{Binding TrashText}" Command="{Binding ResolveCommand}" />
                                </StackPanel>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </DockPanel>
                  <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoading}">
                    <mi:MaterialIcon Kind="Loading" Classes="spin" Width="28" Height="28" Foreground="{DynamicResource AppPrimaryBrush}" />
                    <TextBlock Classes="secondary" l:Tr.Text="Looking for duplicates…" />
                  </StackPanel>
                  <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowEmpty}" MaxWidth="420">
                    <mi:MaterialIcon Kind="CheckCircleOutline" Width="36" Height="36" Foreground="{DynamicResource AppPrimaryBrush}" />
                    <TextBlock Classes="h3" l:Tr.Text="No duplicates" HorizontalAlignment="Center" />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center"
                               l:Tr.Text="Immich finds look-alike photos with machine learning on your server. Nothing to review right now." />
                  </StackPanel>
                  <Border Classes="card" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Spacing="12">
                      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" TextAlignment="Center" />
                      <Button Classes="primary" HorizontalAlignment="Center" l:Tr.Content="Try again" Command="{Binding RefreshCommand}" />
                    </StackPanel>
                  </Border>
                </Panel>
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
        </Panel>

        <!-- Locked folder: PIN prompt -->
        <Border Classes="card" Width="400" Padding="28,26" HorizontalAlignment="Center" VerticalAlignment="Center"
                IsVisible="{Binding ShowLockedPrompt}">
          <StackPanel Spacing="14">
            <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AppPrimarySoftBrush}" HorizontalAlignment="Center">
              <mi:MaterialIcon Kind="Lock" Width="26" Height="26" Foreground="{DynamicResource AppPrimaryBrush}" />
            </Border>
            <TextBlock Classes="h2" l:Tr.Text="Locked folder" HorizontalAlignment="Center" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center"
                       l:Tr.Text="Photos here are hidden from your timeline, albums and search. Enter your Immich PIN to see them." />
            <StackPanel Spacing="10" IsVisible="{Binding CanEnterPin}">
              <TextBox Text="{Binding Pin}" PasswordChar="●" l:Tr.Watermark="PIN code" HorizontalContentAlignment="Center">
                <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding UnlockCommand}" /></TextBox.KeyBindings>
              </TextBox>
              <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding UnlockCommand}"
                      IsEnabled="{Binding !IsUnlocking}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <mi:MaterialIcon Kind="Loading" Classes="spin" Width="16" Height="16" IsVisible="{Binding IsUnlocking}" />
                  <TextBlock l:Tr.Text="Unlock" />
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Classes="caption" Foreground="{DynamicResource AppDangerBrush}" Text="{Binding LockedMessage}" TextWrapping="Wrap"
                       TextAlignment="Center" IsVisible="{Binding LockedMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>

        <!-- Map -->
        <Panel IsVisible="{Binding ShowMap}" Margin="28,4,28,24">
          <Border CornerRadius="18" ClipToBounds="True" BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1">
            <c:MapView Name="Map" Markers="{Binding Markers}" ShowStreetDetail="{Binding ShowStreetDetail}" />
          </Border>
          <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Spacing="6">
            <Button Classes="secondary icon" Name="ZoomInButton" l:Tr.Tip="Zoom in"><mi:MaterialIcon Kind="Plus" Width="18" Height="18" /></Button>
            <Button Classes="secondary icon" Name="ZoomOutButton" l:Tr.Tip="Zoom out"><mi:MaterialIcon Kind="Minus" Width="18" Height="18" /></Button>
            <Button Classes="secondary icon" Name="FitButton" l:Tr.Tip="Show all photos"><mi:MaterialIcon Kind="FitToScreenOutline" Width="18" Height="18" /></Button>
          </StackPanel>
          <!-- Street detail comes from an online map service; the built-in map needs nothing. -->
          <ToggleButton HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="12,7" CornerRadius="999"
                        IsChecked="{Binding ShowStreetDetail}"
                        l:Tr.Tip="Street names and roads come from an online map service (no account or key needed). Off: only the built-in map is used, and nothing about your photos' locations leaves your PC.">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="LayersOutline" Width="18" Height="18" />
              <TextBlock l:Tr.Text="Street detail" />
            </StackPanel>
          </ToggleButton>
          <Button Name="ShowAreaButton" Classes="primary" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,34">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="ImageMultipleOutline" />
              <TextBlock Name="ShowAreaText" l:Tr.Text="Show photos in this area" />
            </StackPanel>
          </Button>
        </Panel>

        <!-- Albums / people / places / map: loading and messages -->
        <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoadingCollection}">
          <mi:MaterialIcon Kind="Loading" Classes="spin" Width="28" Height="28" Foreground="{DynamicResource AppPrimaryBrush}" />
        </StackPanel>
        <TextBlock Classes="secondary" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                   Text="{Binding CollectionMessage}" IsVisible="{Binding ShowAlbums}" />
        <TextBlock Classes="secondary" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                   Text="{Binding CollectionMessage}" IsVisible="{Binding ShowMap}" />
      </Panel>
    </DockPanel>

    <!-- Notice (e.g. "Link copied") -->
    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Padding="16,10" CornerRadius="12"
            Background="{DynamicResource AppTextBrush}" IsHitTestVisible="False"
            IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource AppPageBrush}" FontWeight="Medium" />
    </Border>

    <!-- Viewer -->
    <Panel Name="ViewerLayer" IsVisible="{Binding Viewer, Converter={x:Static ObjectConverters.IsNotNull}}" Background="Black" Focusable="True">
      <DockPanel DataContext="{Binding Viewer}" x:DataType="vm:PhotoViewerViewModel">
        <!-- Info panel -->
        <Border DockPanel.Dock="Right" Width="320" Background="#181818" IsVisible="{Binding ShowInfo}" Padding="22,72,22,22">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
              <TextBlock l:Tr.Text="Info" Foreground="White" FontSize="18" FontWeight="SemiBold" />
              <StackPanel Spacing="2" IsVisible="{Binding DateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Classes="infoLabel" l:Tr.Text="Taken" />
                <TextBlock Classes="infoValue" Text="{Binding DateText}" />
              </StackPanel>
              <StackPanel Spacing="2" IsVisible="{Binding FileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Classes="infoLabel" l:Tr.Text="File" />
                <TextBlock Classes="infoValue" Text="{Binding FileName}" />
                <TextBlock Classes="infoLabel" Text="{Binding Dimensions}" />
              </StackPanel>
              <StackPanel Spacing="2" IsVisible="{Binding Camera, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Classes="infoLabel" l:Tr.Text="Camera" />
                <TextBlock Classes="infoValue" Text="{Binding Camera}" />
                <TextBlock Classes="infoLabel" Text="{Binding Lens}" IsVisible="{Binding Lens, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="infoLabel" Text="{Binding Exposure}" IsVisible="{Binding Exposure, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              <StackPanel Spacing="2" IsVisible="{Binding Place, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Classes="infoLabel" l:Tr.Text="Location" />
                <TextBlock Classes="infoValue" Text="{Binding Place}" />
              </StackPanel>
              <StackPanel Spacing="2" IsVisible="{Binding People, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Classes="infoLabel" l:Tr.Text="People" />
                <TextBlock Classes="infoValue" Text="{Binding People}" />
              </StackPanel>
              <StackPanel Spacing="2" IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Classes="infoLabel" l:Tr.Text="Description" />
                <TextBlock Classes="infoValue" Text="{Binding Description}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <Panel>
          <!-- The photo: scroll to zoom, drag to move when zoomed, double-click to zoom in/out -->
          <Panel Name="ViewerStage" Margin="64,64,64,20" ClipToBounds="True" Background="Transparent">
            <Image Name="ViewerImage" Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <!-- The playing video, drawn over its preview once the first frame arrives -->
            <Panel Background="Black" IsVisible="{Binding HasVideoFrame}">
              <Image Name="VideoSurface" Source="{Binding VideoFrame}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="MediumQuality" />
            </Panel>
          </Panel>
          <mi:MaterialIcon Kind="Loading" Classes="spin" Width="28" Height="28" Foreground="White" IsVisible="{Binding IsLoading}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
          <!-- Video: big play button (paused or not started) -->
          <Button Classes="playVideo" Command="{Binding PlayPauseCommand}" HorizontalAlignment="Center" VerticalAlignment="Center"
                  l:Tr.Tip="Play (Space)">
            <Button.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="ShowBigPlay" />
                <Binding Path="CanPlayHere" />
              </MultiBinding>
            </Button.IsVisible>
            <mi:MaterialIcon Kind="Play" Width="40" Height="40" Foreground="White" />
          </Button>
          <!-- Video: can't play here, offer the PC's player -->
          <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18,14" CornerRadius="14" Background="#CC000000" MaxWidth="420"
                  IsVisible="{Binding !CanPlayHere}">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding VideoError}" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" />
              <Button Classes="primary" HorizontalAlignment="Center" Command="{Binding OpenInVideoPlayerCommand}" IsEnabled="{Binding !IsFetchingVideo}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <mi:MaterialIcon Kind="Loading" Classes="spin" Width="16" Height="16" IsVisible="{Binding IsFetchingVideo}" />
                  <TextBlock Text="{Binding VideoProgress}" IsVisible="{Binding IsFetchingVideo}" />
                  <TextBlock l:Tr.Text="Open in video player" IsVisible="{Binding !IsFetchingVideo}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
          <!-- Video: controls -->
          <Border HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="80,0,80,48" Padding="10,6" CornerRadius="14" Background="#B3000000"
                  MaxWidth="900" IsVisible="{Binding IsVideoStarted}">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" VerticalAlignment="Center">
              <Button Classes="videoControl" Command="{Binding PlayPauseCommand}" l:Tr.Tip="Play or pause (Space)">
                <Panel>
                  <mi:MaterialIcon Kind="Pause" IsVisible="{Binding IsVideoPlaying}" />
                  <mi:MaterialIcon Kind="Play" IsVisible="{Binding !IsVideoPlaying}" />
                </Panel>
              </Button>
              <Button Grid.Column="1" Classes="videoControl" Command="{Binding SkipBackCommand}" l:Tr.Tip="Back 10 seconds">
                <mi:MaterialIcon Kind="Rewind10" />
              </Button>
              <Button Grid.Column="2" Classes="videoControl" Command="{Binding SkipForwardCommand}" l:Tr.Tip="Forward 10 seconds">
                <mi:MaterialIcon Kind="FastForward10" />
              </Button>
              <Slider Grid.Column="3" Classes="videoSeek" Minimum="0" Maximum="1" Value="{Binding VideoPosition}" Margin="10,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="4" Text="{Binding VideoTimeText}" Foreground="White" FontSize="12.5" VerticalAlignment="Center" Margin="4,0,8,0"
                         FontFeatures="tnum" />
              <Button Grid.Column="5" Classes="videoControl" Command="{Binding ToggleMuteCommand}" l:Tr.Tip="Mute (M)">
                <Panel>
                  <mi:MaterialIcon Kind="VolumeOff" IsVisible="{Binding IsMuted}" />
                  <mi:MaterialIcon Kind="VolumeHigh" IsVisible="{Binding !IsMuted}" />
                </Panel>
              </Button>
            </Grid>
          </Border>

          <!-- Top bar -->
          <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Top" Margin="14,12">
            <Button Classes="viewerNav" Command="{Binding CloseCommand}" l:Tr.Tip="Close (Esc)">
              <mi:MaterialIcon Kind="Close" />
            </Button>
            <TextBlock Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Text="{Binding Error}" Foreground="#FFB4B4" FontSize="12.5"
                       TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
              <Button Classes="viewerNav" Command="{Binding ToggleFavoriteCommand}" IsVisible="{Binding CanEdit}" l:Tr.Tip="Favorite (F)">
                <Panel>
                  <mi:MaterialIcon Kind="Heart" IsVisible="{Binding IsFavorite}" />
                  <mi:MaterialIcon Kind="HeartOutline" IsVisible="{Binding !IsFavorite}" />
                </Panel>
              </Button>
              <Button Classes="viewerNav" Command="{Binding ShowInFolderCommand}" IsVisible="{Binding IsOnDevice}" l:Tr.Tip="Show in folder">
                <mi:MaterialIcon Kind="FolderOpenOutline" />
              </Button>
              <Button Classes="viewerNav" Command="{Binding CopyImageCommand}" IsVisible="{Binding !IsVideo}" l:Tr.Tip="Copy picture (Ctrl+C)">
                <mi:MaterialIcon Kind="ContentCopy" />
              </Button>
              <Button Classes="viewerNav" Command="{Binding ShareCommand}" IsVisible="{Binding CanEdit}" l:Tr.Tip="Share">
                <mi:MaterialIcon Kind="ShareVariantOutline" />
              </Button>
              <Button Classes="viewerNav" Command="{Binding AddToAlbumCommand}" IsVisible="{Binding CanEdit}" l:Tr.Tip="Add to album">
                <mi:MaterialIcon Kind="ImagePlusOutline" />
              </Button>
              <Button Classes="viewerNav" Command="{Binding DownloadCommand}" IsVisible="{Binding CanEdit}" l:Tr.Tip="Download">
                <mi:MaterialIcon Kind="TrayArrowDown" />
              </Button>
              <Button Classes="viewerNav" Command="{Binding ToggleInfoCommand}" IsVisible="{Binding IsInImmich}" l:Tr.Tip="Info (I)">
                <mi:MaterialIcon Kind="InformationOutline" />
              </Button>
              <Button Classes="viewerNav" Command="{Binding TrashCommand}" IsVisible="{Binding CanEdit}" l:Tr.Tip="Move to trash (Delete)">
                <mi:MaterialIcon Kind="TrashCanOutline" />
              </Button>
              <Button Classes="viewerNav" Command="{Binding OpenInImmichCommand}" IsVisible="{Binding IsInImmich}"
                      ToolTip.Tip="{Binding IsVideo, Converter={x:Static vm:Converters.VideoOpenText}}">
                <mi:MaterialIcon Kind="OpenInNew" />
              </Button>
              <Button Classes="viewerNav" Command="{Binding OpenFileCommand}" IsVisible="{Binding IsLocalOnly}" l:Tr.Tip="Open file">
                <mi:MaterialIcon Kind="OpenInNew" />
              </Button>
            </StackPanel>
          </Grid>

          <!-- Date (and for files only on this PC, their backup status), under the photo -->
          <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Padding="12,5" CornerRadius="10" Background="#99000000"
                  IsHitTestVisible="False" IsVisible="{Binding DateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding DateText}" Foreground="White" FontWeight="Medium" FontSize="13" />
              <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding IsLocalOnly}">
                <mi:MaterialIcon Kind="CloudUploadOutline" Width="15" Height="15" Foreground="#FFD9A0" />
                <TextBlock Text="{Binding LocalStatus}" Foreground="#FFD9A0" FontSize="12.5" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Button Classes="viewerNav" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0"
                  Command="{Binding PreviousCommand}" l:Tr.Tip="Newer (←)">
            <mi:MaterialIcon Kind="ChevronLeft" Width="28" Height="28" />
          </Button>
          <Button Classes="viewerNav" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0"
                  Command="{Binding NextCommand}" l:Tr.Tip="Older (→)">
            <mi:MaterialIcon Kind="ChevronRight" Width="28" Height="28" />
          </Button>
        </Panel>
      </DockPanel>
    </Panel>

    <!-- Share / add to album panel -->
    <Panel IsVisible="{Binding Panel, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{DynamicResource AppOverlayBrush}">
      <Border Classes="card" Width="440" Padding="24,22" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource AppPageBrush}" BoxShadow="0 18 50 0 #40000000">
        <ContentControl Content="{Binding Panel}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:SharePanelViewModel">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="h2" l:Tr.Text="Share" />
                    <TextBlock Classes="secondary" Text="{Binding What, StringFormat='Anyone with the link can see {0}.'}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="ghost icon" VerticalAlignment="Top" Command="{Binding CloseCommand}">
                    <mi:MaterialIcon Kind="Close" Width="20" Height="20" />
                  </Button>
                </Grid>
                <StackPanel Spacing="12" IsVisible="{Binding !HasLink}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock l:Tr.Text="Link expires" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" Width="150" ItemsSource="{Binding Expiries}" SelectedItem="{Binding SelectedExpiry}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock l:Tr.Text="Allow downloads" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AllowDownload}" OnContent="" OffContent="" />
                  </Grid>
                  <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding CreateCommand}"
                          IsEnabled="{Binding !IsWorking}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <mi:MaterialIcon Kind="Loading" Classes="spin" Width="16" Height="16" IsVisible="{Binding IsWorking}" />
                      <mi:MaterialIcon Kind="LinkVariant" IsVisible="{Binding !IsWorking}" />
                      <TextBlock l:Tr.Text="Create link" />
                    </StackPanel>
                  </Button>
                </StackPanel>
                <StackPanel Spacing="10" IsVisible="{Binding HasLink}">
                  <TextBox Text="{Binding Link}" IsReadOnly="True" />
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <TextBlock Classes="caption" l:Tr.Text="Copied to clipboard" VerticalAlignment="Center" Foreground="{DynamicResource AppSuccessBrush}"
                               IsVisible="{Binding Copied}" Margin="0,0,6,0" />
                    <Button Classes="secondary" Command="{Binding OpenLinkCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="OpenInNew" /><TextBlock l:Tr.Text="Open" /></StackPanel>
                    </Button>
                    <Button Classes="primary" Command="{Binding CopyCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="ContentCopy" /><TextBlock l:Tr.Text="Copy" /></StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>
                <TextBlock Classes="caption" Foreground="{DynamicResource AppDangerBrush}" Text="{Binding Error}" TextWrapping="Wrap"
                           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </DataTemplate>
            <DataTemplate DataType="vm:PinPanelViewModel">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="h2" l:Tr.Text="Locked folder" />
                    <TextBlock Classes="secondary" l:Tr.Text="Enter your Immich PIN to move photos into the locked folder." TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="ghost icon" VerticalAlignment="Top" Command="{Binding CloseCommand}">
                    <mi:MaterialIcon Kind="Close" Width="20" Height="20" />
                  </Button>
                </Grid>
                <TextBox Text="{Binding Pin}" PasswordChar="●" l:Tr.Watermark="PIN code" HorizontalContentAlignment="Center">
                  <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding UnlockCommand}" /></TextBox.KeyBindings>
                </TextBox>
                <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding UnlockCommand}"
                        IsEnabled="{Binding !IsWorking}" l:Tr.Content="Unlock" />
                <TextBlock Classes="caption" Foreground="{DynamicResource AppDangerBrush}" Text="{Binding Error}" TextWrapping="Wrap"
                           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </DataTemplate>
            <DataTemplate DataType="vm:AlbumPickerViewModel">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="h2" l:Tr.Text="Add to album" />
                    <TextBlock Classes="secondary" Text="{Binding What}" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="ghost icon" VerticalAlignment="Top" Command="{Binding CloseCommand}">
                    <mi:MaterialIcon Kind="Close" Width="20" Height="20" />
                  </Button>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Text="{Binding NewAlbumName}" l:Tr.Watermark="New album name">
                    <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding CreateCommand}" /></TextBox.KeyBindings>
                  </TextBox>
                  <Button Grid.Column="1" Classes="primary" Margin="8,0,0,0" l:Tr.Content="Create" Command="{Binding CreateCommand}" IsEnabled="{Binding !IsWorking}" />
                </Grid>
                <TextBlock Classes="section" l:Tr.Text="YOUR ALBUMS" Margin="0,6,0,0" />
                <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding Albums}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="api:AlbumInfo">
                        <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8"
                                Command="{Binding $parent[ItemsControl].((vm:AlbumPickerViewModel)DataContext).AddToCommand}" CommandParameter="{Binding}">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <mi:MaterialIcon Kind="ImageAlbum" Width="18" Height="18" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="{Binding AlbumName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="caption" Text="{Binding AssetCount}" VerticalAlignment="Center" Margin="10,0,0,0" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <mi:MaterialIcon Kind="Loading" Classes="spin" Width="22" Height="22" IsVisible="{Binding IsWorking}" HorizontalAlignment="Center" />
                <TextBlock Classes="caption" Foreground="{DynamicResource AppDangerBrush}" Text="{Binding Error}" TextWrapping="Wrap"
                           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </Border>
    </Panel>
  </Panel>
</UserControl>
