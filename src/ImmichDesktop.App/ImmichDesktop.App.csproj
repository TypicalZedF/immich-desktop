<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ImmichDesktop</AssemblyName>
    <RootNamespace>ImmichDesktop.App</RootNamespace>
    <!-- Windows builds get the Windows SDK projection (Windows Hello); other platforms stay plain net10.0. -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::IsOSPlatform('Windows'))">10.0.17763.0</SupportedOSPlatformVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\app.ico')">Assets\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Keep the background footprint small -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- The logo as a plain file, for desktop notifications (Windows and Linux need a path). -->
    <None Include="Assets\logo-256.png" Link="notification-icon.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- libmpv plays videos on Windows (downloaded into lib/mpv by build/publish.ps1; Linux uses the system's). -->
    <None Include="..\..\lib\mpv\libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Condition="$([MSBuild]::IsOSPlatform('Windows')) And Exists('..\..\lib\mpv\libmpv-2.dll')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Material.Icons.Avalonia" />
    <PackageReference Include="LibVLCSharp" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

  <!-- Video playback: only 64-bit VLC, without parts the viewer never uses (streaming out, skins, scripting…) -->
  <PropertyGroup>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>
  <ItemGroup>
    <VlcWindowsX64ExcludeFiles Include="plugins\gui\%2A;plugins\lua\%2A;lua\%2A%2A;plugins\visualization\%2A;plugins\services_discovery\%2A;plugins\stream_out\%2A;plugins\access_output\%2A;plugins\control\%2A" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImmichDesktop.Core\ImmichDesktop.Core.csproj" />
  </ItemGroup>
</Project>
