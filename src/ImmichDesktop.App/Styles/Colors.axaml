<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="AppPageBrush" Color="#F4F5F9" />
      <SolidColorBrush x:Key="AppSidebarBrush" Color="#F4F5F9" />
      <SolidColorBrush x:Key="AppCardBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AppCardBorderBrush" Color="#E5E7EF" />
      <SolidColorBrush x:Key="AppDividerBrush" Color="#ECEEF4" />
      <SolidColorBrush x:Key="AppHoverBrush" Color="#E9EBF3" />
      <SolidColorBrush x:Key="AppInputBrush" Color="#F7F8FB" />
      <SolidColorBrush x:Key="AppTextBrush" Color="#16181D" />
      <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#5D6170" />
      <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#8A8E9C" />
      <SolidColorBrush x:Key="AppPrimaryBrush" Color="#4250AF" />
      <SolidColorBrush x:Key="AppPrimaryHoverBrush" Color="#3A479F" />
      <SolidColorBrush x:Key="AppPrimaryPressedBrush" Color="#323E8C" />
      <SolidColorBrush x:Key="AppOnPrimaryBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AppPrimarySoftBrush" Color="#E5E8F8" />
      <SolidColorBrush x:Key="AppSuccessBrush" Color="#1E8E4F" />
      <SolidColorBrush x:Key="AppSuccessSoftBrush" Color="#E2F5E9" />
      <SolidColorBrush x:Key="AppWarningBrush" Color="#B86E00" />
      <SolidColorBrush x:Key="AppWarningSoftBrush" Color="#FFF1D9" />
      <SolidColorBrush x:Key="AppDangerBrush" Color="#C62828" />
      <SolidColorBrush x:Key="AppDangerSoftBrush" Color="#FCE8E8" />
      <SolidColorBrush x:Key="AppNeutralSoftBrush" Color="#ECEEF3" />
      <SolidColorBrush x:Key="AppOverlayBrush" Color="#5C0B0D14" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AppPageBrush" Color="#0E0F12" />
      <SolidColorBrush x:Key="AppSidebarBrush" Color="#0E0F12" />
      <SolidColorBrush x:Key="AppCardBrush" Color="#17181D" />
      <SolidColorBrush x:Key="AppCardBorderBrush" Color="#25262E" />
      <SolidColorBrush x:Key="AppDividerBrush" Color="#22232A" />
      <SolidColorBrush x:Key="AppHoverBrush" Color="#22242C" />
      <SolidColorBrush x:Key="AppInputBrush" Color="#1D1E24" />
      <SolidColorBrush x:Key="AppTextBrush" Color="#ECEDF2" />
      <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#A3A7B5" />
      <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#6E7280" />
      <SolidColorBrush x:Key="AppPrimaryBrush" Color="#ADCBFA" />
      <SolidColorBrush x:Key="AppPrimaryHoverBrush" Color="#C0D7FB" />
      <SolidColorBrush x:Key="AppPrimaryPressedBrush" Color="#9ABEF8" />
      <SolidColorBrush x:Key="AppOnPrimaryBrush" Color="#0D1526" />
      <SolidColorBrush x:Key="AppPrimarySoftBrush" Color="#1E2940" />
      <SolidColorBrush x:Key="AppSuccessBrush" Color="#7AD9A0" />
      <SolidColorBrush x:Key="AppSuccessSoftBrush" Color="#132A1C" />
      <SolidColorBrush x:Key="AppWarningBrush" Color="#F6C46B" />
      <SolidColorBrush x:Key="AppWarningSoftBrush" Color="#2E2410" />
      <SolidColorBrush x:Key="AppDangerBrush" Color="#FF8A80" />
      <SolidColorBrush x:Key="AppDangerSoftBrush" Color="#351818" />
      <SolidColorBrush x:Key="AppNeutralSoftBrush" Color="#22242B" />
      <SolidColorBrush x:Key="AppOverlayBrush" Color="#99000000" />
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <LinearGradientBrush x:Key="AppLogoBrush" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Offset="0" Color="#6E7CF0" />
    <GradientStop Offset="1" Color="#3E4AA6" />
  </LinearGradientBrush>
</ResourceDictionary>
