<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

  <!-- ===== Base ===== -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource ImmichFont}" />
    <Setter Property="Background" Value="{DynamicResource AppPageBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- ===== Typography ===== -->
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.tertiary">
    <Setter Property="Foreground" Value="{DynamicResource AppTextTertiaryBrush}" />
  </Style>
  <Style Selector="TextBlock.stat">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
  </Style>

  <!-- ===== Surfaces ===== -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="22" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource AppDividerBrush}" />
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Background" Value="{DynamicResource AppNeutralSoftBrush}" />
  </Style>
  <Style Selector="Border.iconChip">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{DynamicResource AppPrimarySoftBrush}" />
  </Style>
  <Style Selector="Border.iconChip > mi|MaterialIcon">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
  </Style>
  <Style Selector="Border.banner">
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Background" Value="{DynamicResource AppPrimarySoftBrush}" />
  </Style>
  <Style Selector="Border.banner.error">
    <Setter Property="Background" Value="{DynamicResource AppDangerSoftBrush}" />
  </Style>
  <Style Selector="Border.banner.error TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
  </Style>
  <Style Selector="Border.banner.error mi|MaterialIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
  </Style>
  <Style Selector="Border.banner.warning">
    <Setter Property="Background" Value="{DynamicResource AppWarningSoftBrush}" />
  </Style>
  <Style Selector="Border.banner.warning TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}" />
  </Style>
  <Style Selector="Border.banner.warning mi|MaterialIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}" />
  </Style>

  <!-- Tone classes: tint an icon chip by status -->
  <Style Selector="Border.tone">
    <Setter Property="Background" Value="{DynamicResource AppSuccessSoftBrush}" />
  </Style>
  <Style Selector="Border.tone > mi|MaterialIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
  </Style>
  <Style Selector="Border.tone.busy">
    <Setter Property="Background" Value="{DynamicResource AppPrimarySoftBrush}" />
  </Style>
  <Style Selector="Border.tone.busy > mi|MaterialIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
  </Style>
  <Style Selector="Border.tone.paused">
    <Setter Property="Background" Value="{DynamicResource AppNeutralSoftBrush}" />
  </Style>
  <Style Selector="Border.tone.paused > mi|MaterialIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.tone.warning">
    <Setter Property="Background" Value="{DynamicResource AppWarningSoftBrush}" />
  </Style>
  <Style Selector="Border.tone.warning > mi|MaterialIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}" />
  </Style>
  <Style Selector="Border.tone.error">
    <Setter Property="Background" Value="{DynamicResource AppDangerSoftBrush}" />
  </Style>
  <Style Selector="Border.tone.error > mi|MaterialIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
  </Style>

  <!-- Spinning icon (sync / loading) -->
  <Style Selector="mi|MaterialIcon.spin">
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Style.Animations>
      <Animation Duration="0:0:1.1" IterationCount="Infinite">
        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="mi|MaterialIcon.spinReverse">
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Style.Animations>
      <Animation Duration="0:0:1.1" IterationCount="Infinite">
        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- ===== Buttons ===== -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="18,9" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button mi|MaterialIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>

  <!-- primary -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AppPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppOnPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppPrimaryHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppOnPrimaryBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppPrimaryPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppOnPrimaryBrush}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppOnPrimaryBrush}" />
  </Style>
  <Style Selector="Button.primary:disabled">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="Button.large">
    <Setter Property="Padding" Value="22,13" />
    <Setter Property="FontSize" Value="15" />
  </Style>

  <!-- secondary (outlined) -->
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppNeutralSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="Button.secondary:disabled">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <!-- ghost (text / icon) -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppNeutralSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="9" />
  </Style>

  <!-- danger -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource AppDangerSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppDangerSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppDangerSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
  </Style>
  <Style Selector="Button.primary.danger">
    <Setter Property="Background" Value="{DynamicResource AppDangerBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.primary.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppDangerBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <!-- link -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AppPrimaryHoverBrush}" />
  </Style>
  <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ===== Inputs ===== -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="14,11" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource AppInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
  </Style>
  <Style Selector="TextBox.multiline">
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="MinHeight" Value="92" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="MinWidth" Value="170" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Background" Value="{DynamicResource AppInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource AppNeutralSoftBrush}" />
  </Style>
  <Style Selector="ProgressBar.thin">
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="Height" Value="4" />
  </Style>
  <Style Selector="ProgressBar.success">
    <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
  </Style>

  <!-- ===== Sidebar navigation ===== -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="26,13" />
    <Setter Property="Margin" Value="0,1,16,1" />
    <Setter Property="CornerRadius" Value="0,999,999,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0,999,999,0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppPrimarySoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppPrimarySoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppPrimarySoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppNeutralSoftBrush}" />
  </Style>

  <!-- ===== Segmented control (RadioButtons) ===== -->
  <Style Selector="Border.segmented">
    <Setter Property="Background" Value="{DynamicResource AppNeutralSoftBrush}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="RadioButton.segment">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Bg" Background="Transparent" CornerRadius="999" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Padding" Value="16,7" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
  </Style>
  <Style Selector="RadioButton.segment:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="RadioButton.segment:checked">
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="RadioButton.segment:checked /template/ Border#PART_Bg">
    <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
    <Setter Property="BoxShadow" Value="0 1 3 0 #22000000" />
  </Style>

  <!-- ===== Step dots ===== -->
  <Style Selector="Border.stepDot">
    <Setter Property="Height" Value="6" />
    <Setter Property="Width" Value="8" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{DynamicResource AppCardBorderBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Width" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.stepDot.active">
    <Setter Property="Width" Value="28" />
    <Setter Property="Background" Value="{DynamicResource AppPrimaryBrush}" />
  </Style>

  <!-- Filled icon for the active sidebar item, outline otherwise (as in Immich) -->
  <Style Selector="ListBox.nav ListBoxItem mi|MaterialIcon.active">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected mi|MaterialIcon.active">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected mi|MaterialIcon.inactive">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- ===== Scroll / tooltip polish ===== -->
  <Style Selector="ToolTip">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
</Styles>
